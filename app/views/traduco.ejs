<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="wrap traduco">
  <%- include('partials/poem-header') %>

  <div class="tpick">
    <details class="list-picker tp1">
      <summary><%= t1.translator %><%= t1.year ? ', ' + t1.year : '' %></summary>
      <div class="list-panel">
        <% groups.forEach((g) => { %><div class="lgrp"><p class="lgroup"><%= __('trad.lang.' + g.lang) %></p><ul><% g.items.forEach((t) => { const href = '?t=' + t.id + (t2 && t2.id !== t.id ? '&t2=' + t2.id : ''); %><li><a href="<%= href %>"<%- t.id === t1.id ? ' aria-current="true"' : '' %>><%= t.translator %><%= t.year ? ', ' + t.year : '' %></a></li><% }) %></ul></div><% }) %>
      </div>
    </details>
    <details class="list-picker tp2<%= t2 ? "" : " empty" %>">
      <summary><%= t2 ? t2.translator + (t2.year ? ', ' + t2.year : '') : __('trad.compare') %></summary>
      <div class="list-panel">
        <p class="lnone"><a href="?t=<%= t1.id %>"<%- t2 ? '' : ' aria-current="true"' %>><%= __('trad.none') %></a></p>
        <% groups.forEach((g) => { const items = g.items.filter((t) => t.id !== t1.id); if (!items.length) return; %><div class="lgrp"><p class="lgroup"><%= __('trad.lang.' + g.lang) %></p><ul><% items.forEach((t) => { %><li><a href="?t=<%= t1.id %>&amp;t2=<%= t.id %>"<%- t2 && t.id === t2.id ? ' aria-current="true"' : '' %>><%= t.translator %><%= t.year ? ', ' + t.year : '' %></a></li><% }) %></ul></div><% }) %>
      </div>
    </details>
  </div>

  <div class="tcols<%= t2 ? ' three' : '' %>">
    <section class="tcol it" lang="it">
      <h2 class="tname"><%= __('trad.italian') %></h2>
      <p class="print-head"><% trad.italian.head.forEach((h) => { %><span><%= h %></span><% }) %></p>
      <% trad.italian.stanzas.forEach((stanza) => { %><div class="tstanza"><% stanza.forEach((item) => { if (item.type === 'l') { %><p class="tl"><span class="vn"><%= item.n && item.n % 5 === 0 ? item.n : '' %></span><span><%- item.html %></span></p><% } }) %></div><% }) %>
    </section>
    <% [t1, t2].filter(Boolean).forEach((t) => { %>
    <section class="tcol" lang="<%= t.lang %>">
      <h2 class="tname" title="<%= t.translator %><%= t.year ? ', ' + t.year : '' %>"><%= t.translator %><%= t.year ? ', ' + t.year : '' %></h2>
      <% if (t.title.length) { %><p class="print-head"><% t.title.forEach((line) => { %><span><%= line %></span><% }) %></p><% } %>
      <% t.stanzas.forEach((stanza) => { if (t.form === 'prose') { stanza.forEach((para) => { %><p class="tprose"><%= para %></p><% }) } else { %><div class="tstanza"><% stanza.forEach((line) => { %><p class="tl"><span><%= line %></span></p><% }) %></div><% } }) %>
    </section>
    <% }) %>
  </div>

  <section class="tsources" aria-label="<%= __('trad.source') %>">
    <% [t1, t2].filter(Boolean).forEach((t) => { %>
    <div class="tsrc">
      <h2><%= t.translator %><%= t.year ? ', ' + t.year : '' %></h2>
      <p><%= t.bibl %></p>
      <% if (t.sources.length) { %><ul><% t.sources.forEach((s) => { %><li><% if (s.url) { %><a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %></a><% } else { %><%= s.label %><% } %></li><% }) %></ul><% } %>
      <p class="rights"><%= t.rights %></p>
      <% t.notes.forEach((note) => { %><p class="tnote"><%= note %></p><% }) %>
    </div>
    <% }) %>
  </section>
</main>
<%- include('partials/footer') %>
