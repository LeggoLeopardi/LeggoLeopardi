<% const mod = typeof selectModule !== 'undefined' ? selectModule : 'leggo'; %>
<form class="poem-select" action="/<%= mod %>" method="get">
  <label for="poem-select" class="eyebrow"><%= __('leggo.choose') %></label>
  <select id="poem-select" name="n" onchange="this.form.submit()">
    <% canti.forEach((p) => { %>
      <option value="<%= p.n %>"<%= p.n === poem.n ? ' selected' : '' %><%= !p.status[mod] || p.status[mod] === 'none' ? ' disabled' : '' %>><%= p.roman %>. <%= p.title || p.incipit %></option>
    <% }) %>
  </select>
  <noscript><button type="submit"><%= __('leggo.go') %></button></noscript>
</form>
