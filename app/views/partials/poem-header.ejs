<header class="poem-bar">
  <% if (pnav.prev) { %><a class="step prev" href="/<%= pnav.mod %>/<%= pnav.prev.n %>" aria-label="<%= __('poem.prev') %>" title="<%= pnav.prev.roman %>. <%= pnav.prev.title || pnav.prev.incipit %>">‹</a><% } else { %><span class="step" aria-hidden="true"></span><% } %>
  <details class="poem-picker"><summary><h1 class="poem-title"><%= poem.roman %>. <%= poem.title || poem.incipit %></h1></summary>
    <ol class="picker" aria-label="<%= __('poem.choose') %>">
      <% pnav.options.forEach((o) => { %><li><% if (o.disabled) { %><span class="off"><span class="num"><%= o.roman %></span><span class="t"><%= o.title %></span></span><% } else { %><a href="/<%= pnav.mod %>/<%= o.n %>"<%- o.n === poem.n ? ' aria-current="page"' : '' %>><span class="num"><%= o.roman %></span><span class="t"><%= o.title %></span></a><% } %></li>
      <% }) %>
    </ol>
  </details>
  <% if (pnav.next) { %><a class="step next" href="/<%= pnav.mod %>/<%= pnav.next.n %>" aria-label="<%= __('poem.next') %>" title="<%= pnav.next.roman %>. <%= pnav.next.title || pnav.next.incipit %>">›</a><% } else { %><span class="step" aria-hidden="true"></span><% } %>
</header>
<script src="/js/site.js" defer></script>
