{"n": 26, "roman": "XXVI", "title": "Il pensiero dominante", "slug": "il-pensiero-dominante", "incipit": "Dolcissimo, possente", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.120", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.121", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.122", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.123", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.124", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.125", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVI.%E2%80%96_IL_PENSIERO_DOMINANTE_p.126"]}, "head": ["XXVI.", "IL PENSIERO DOMINANTE."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c26.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Dolcissimo, possente", "html": "Dolcissimo, possente"}, {"type": "l", "n": 2, "id": "c26.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Dominator di mia profonda mente;", "html": "Dominator di mia profonda mente;"}, {"type": "l", "n": 3, "id": "c26.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Terribile, ma caro", "html": "Terribile, ma caro"}, {"type": "l", "n": 4, "id": "c26.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Dono del ciel; consorte", "html": "Dono del ciel; consorte"}, {"type": "l", "n": 5, "id": "c26.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Ai lúgubri miei giorni,", "html": "Ai lúgubri miei giorni,"}, {"type": "l", "n": 6, "id": "c26.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Pensier che innanzi a me sì spesso torni.", "html": "Pensier che innanzi a me sì spesso torni."}], [{"type": "l", "n": 7, "id": "c26.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Di tua natura arcana", "html": "Di tua natura arcana"}, {"type": "l", "n": 8, "id": "c26.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi non favella? il suo poter fra noi", "html": "Chi non favella? il suo poter fra noi"}, {"type": "l", "n": 9, "id": "c26.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi non sentì? Pur sempre", "html": "Chi non sentì? Pur sempre"}, {"type": "l", "n": 10, "id": "c26.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Che in dir gli effetti suoi", "html": "Che in dir gli effetti suoi"}, {"type": "l", "n": 11, "id": "c26.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Le umane lingue il sentir propio sprona,", "html": "Le umane lingue il sentir propio sprona,"}, {"type": "l", "n": 12, "id": "c26.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Par novo ad ascoltar ciò ch’ei ragiona.", "html": "Par novo ad ascoltar ciò ch’ei ragiona."}], [{"type": "l", "n": 13, "id": "c26.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Come solinga è fatta", "html": "Come solinga è fatta"}, {"type": "l", "n": 14, "id": "c26.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "La mente mia d’allora", "html": "La mente mia d’allora"}, {"type": "l", "n": 15, "id": "c26.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tu quivi prendesti a far dimora!", "html": "Che tu quivi prendesti a far dimora!"}, {"type": "l", "n": 16, "id": "c26.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Ratto d’intorno intorno al par del lampo", "html": "Ratto d’intorno intorno al par del lampo"}, {"type": "l", "n": 17, "id": "c26.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Gli altri pensieri miei", "html": "Gli altri pensieri miei"}, {"type": "l", "n": 18, "id": "c26.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutti si dileguàr. Siccome torre", "html": "Tutti si dileguàr. Siccome torre"}, {"type": "l", "n": 19, "id": "c26.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "In solitario campo,", "html": "In solitario campo,"}, {"type": "l", "n": 20, "id": "c26.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu stai solo, gigante, in mezzo a lei.", "html": "Tu stai solo, gigante, in mezzo a lei."}], [{"type": "l", "n": 21, "id": "c26.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Che divenute son, fuor di te solo,", "html": "Che divenute son, fuor di te solo,"}, {"type": "l", "n": 22, "id": "c26.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutte l’opre terrene,", "html": "Tutte l’opre terrene,"}, {"type": "l", "n": 23, "id": "c26.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutta intera la vita al guardo mio!", "html": "Tutta intera la vita al guardo mio!"}, {"type": "l", "n": 24, "id": "c26.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Che intollerabil noia", "html": "Che intollerabil noia"}, {"type": "l", "n": 25, "id": "c26.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Gli ozi, i commerci usati,", "html": "Gli ozi, i commerci usati,"}, {"type": "l", "n": 26, "id": "c26.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "E di vano piacer la vana spene,", "html": "E di vano piacer la vana spene,"}, {"type": "l", "n": 27, "id": "c26.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Allato a quella gioia,", "html": "Allato a quella gioia,"}, {"type": "l", "n": 28, "id": "c26.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Gioia celeste che da te mi viene!", "html": "Gioia celeste che da te mi viene!"}], [{"type": "l", "n": 29, "id": "c26.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Come da’ nudi sassi", "html": "Come da’ nudi sassi"}, {"type": "l", "n": 30, "id": "c26.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Dello scabro Apennino", "html": "Dello scabro Apennino"}, {"type": "l", "n": 31, "id": "c26.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "A un campo verde che lontan sorrida", "html": "A un campo verde che lontan sorrida"}, {"type": "l", "n": 32, "id": "c26.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Volge gli occhi bramoso il pellegrino;", "html": "Volge gli occhi bramoso il pellegrino;"}, {"type": "l", "n": 33, "id": "c26.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Tal io dal secco ed aspro", "html": "Tal io dal secco ed aspro"}, {"type": "l", "n": 34, "id": "c26.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Mondano conversar vogliosamente,", "html": "Mondano conversar vogliosamente,"}, {"type": "l", "n": 35, "id": "c26.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi in lieto giardino, a te ritorno,", "html": "Quasi in lieto giardino, a te ritorno,"}, {"type": "l", "n": 36, "id": "c26.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "E ristora i miei sensi il tuo soggiorno.", "html": "E ristora i miei sensi il tuo soggiorno."}], [{"type": "l", "n": 37, "id": "c26.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi incredibil parmi", "html": "Quasi incredibil parmi"}, {"type": "l", "n": 38, "id": "c26.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Che la vita infelice e il mondo sciocco", "html": "Che la vita infelice e il mondo sciocco"}, {"type": "l", "n": 39, "id": "c26.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Già per gran tempo assai", "html": "Già per gran tempo assai"}, {"type": "l", "n": 40, "id": "c26.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Senza te sopportai;", "html": "Senza te sopportai;"}, {"type": "l", "n": 41, "id": "c26.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi intender non posso", "html": "Quasi intender non posso"}, {"type": "l", "n": 42, "id": "c26.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Come d’altri desiri,", "html": "Come d’altri desiri,"}, {"type": "l", "n": 43, "id": "c26.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Fuor ch’a te somiglianti, altri sospiri.", "html": "Fuor ch’a te somiglianti, altri sospiri."}], [{"type": "l", "n": 44, "id": "c26.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Giammai d’allor che in pria", "html": "Giammai d’allor che in pria"}, {"type": "l", "n": 45, "id": "c26.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Questa vita che sia per prova intesi,", "html": "Questa vita che sia per prova intesi,"}, {"type": "l", "n": 46, "id": "c26.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Timor di morte non mi strinse il petto.", "html": "Timor di morte non mi strinse il petto."}, {"type": "l", "n": 47, "id": "c26.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Oggi mi pare un gioco", "html": "Oggi mi pare un gioco"}, {"type": "l", "n": 48, "id": "c26.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Quella che il mondo inetto,", "html": "Quella che il mondo inetto,"}, {"type": "l", "n": 49, "id": "c26.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Talor lodando, ognora abborre e trema,", "html": "Talor lodando, ognora abborre e trema,"}, {"type": "l", "n": 50, "id": "c26.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Necessitade estrema;", "html": "Necessitade estrema;"}, {"type": "l", "n": 51, "id": "c26.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "E se periglio appar, con un sorriso", "html": "E se periglio appar, con un sorriso"}, {"type": "l", "n": 52, "id": "c26.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Le sue minacce a contemplar m’affiso.", "html": "Le sue minacce a contemplar m’affiso."}], [{"type": "l", "n": 53, "id": "c26.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Sempre codardi, e l’alme", "html": "Sempre codardi, e l’alme"}, {"type": "l", "n": 54, "id": "c26.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Ingenerose, abbiette", "html": "Ingenerose, abbiette"}, {"type": "l", "n": 55, "id": "c26.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Ebbi in dispregio. Or punge ogni atto indegno", "html": "Ebbi in dispregio. Or punge ogni atto indegno"}, {"type": "l", "n": 56, "id": "c26.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Subito i sensi miei;", "html": "Subito i sensi miei;"}, {"type": "l", "n": 57, "id": "c26.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "Move l’alma ogni esempio", "html": "Move l’alma ogni esempio"}, {"type": "l", "n": 58, "id": "c26.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "Dell’umana viltà subito a sdegno.", "html": "Dell’umana viltà subito a sdegno."}, {"type": "l", "n": 59, "id": "c26.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "Di questa età superba,", "html": "Di questa età superba,"}, {"type": "l", "n": 60, "id": "c26.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "Che di vote speranze si nutrica,", "html": "Che di vote speranze si nutrica,"}, {"type": "l", "n": 61, "id": "c26.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Vaga di ciance, e di virtù nemica;", "html": "Vaga di ciance, e di virtù nemica;"}, {"type": "l", "n": 62, "id": "c26.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "Stolta, che l’util chiede,", "html": "Stolta, che l’util chiede,"}, {"type": "l", "n": 63, "id": "c26.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "E inutile la vita", "html": "E inutile la vita"}, {"type": "l", "n": 64, "id": "c26.v64", "indent": 0, "missing": false, "unnumbered": false, "text": "Quindi più sempre divenir non vede;", "html": "Quindi più sempre divenir non vede;"}, {"type": "l", "n": 65, "id": "c26.v65", "indent": 0, "missing": false, "unnumbered": false, "text": "Maggior mi sento. A scherno", "html": "Maggior mi sento. A scherno"}, {"type": "l", "n": 66, "id": "c26.v66", "indent": 0, "missing": false, "unnumbered": false, "text": "Ho gli umani giudizi; e il vario volgo", "html": "Ho gli umani giudizi; e il vario volgo"}, {"type": "l", "n": 67, "id": "c26.v67", "indent": 0, "missing": false, "unnumbered": false, "text": "A’ bei pensieri infesto,", "html": "A’ bei pensieri infesto,"}, {"type": "l", "n": 68, "id": "c26.v68", "indent": 0, "missing": false, "unnumbered": false, "text": "E degno tuo disprezzator, calpesto.", "html": "E degno tuo disprezzator, calpesto."}], [{"type": "l", "n": 69, "id": "c26.v69", "indent": 0, "missing": false, "unnumbered": false, "text": "A quello onde tu movi,", "html": "A quello onde tu movi,"}, {"type": "l", "n": 70, "id": "c26.v70", "indent": 0, "missing": false, "unnumbered": false, "text": "Quale affetto non cede?", "html": "Quale affetto non cede?"}, {"type": "l", "n": 71, "id": "c26.v71", "indent": 0, "missing": false, "unnumbered": false, "text": "Anzi qual altro affetto", "html": "Anzi qual altro affetto"}, {"type": "l", "n": 72, "id": "c26.v72", "indent": 0, "missing": false, "unnumbered": false, "text": "Se non quell’uno intra i mortali ha sede?", "html": "Se non quell’uno intra i mortali ha sede?"}, {"type": "l", "n": 73, "id": "c26.v73", "indent": 0, "missing": false, "unnumbered": false, "text": "Avarizia, superbia, odio, disdegno,", "html": "Avarizia, superbia, odio, disdegno,"}, {"type": "l", "n": 74, "id": "c26.v74", "indent": 0, "missing": false, "unnumbered": false, "text": "Studio d’onor, di regno,", "html": "Studio d’onor, di regno,"}, {"type": "l", "n": 75, "id": "c26.v75", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sono altro che voglie", "html": "Che sono altro che voglie"}, {"type": "l", "n": 76, "id": "c26.v76", "indent": 0, "missing": false, "unnumbered": false, "text": "Al paragon di lui? Solo un affetto", "html": "Al paragon di lui? Solo un affetto"}, {"type": "l", "n": 77, "id": "c26.v77", "indent": 0, "missing": false, "unnumbered": false, "text": "Vive tra noi: quest’uno,", "html": "Vive tra noi: quest’uno,"}, {"type": "l", "n": 78, "id": "c26.v78", "indent": 0, "missing": false, "unnumbered": false, "text": "Prepotente signore,", "html": "Prepotente signore,"}, {"type": "l", "n": 79, "id": "c26.v79", "indent": 0, "missing": false, "unnumbered": false, "text": "Dieder l’eterne leggi all’uman core.", "html": "Dieder l’eterne leggi all’uman core."}], [{"type": "l", "n": 80, "id": "c26.v80", "indent": 0, "missing": false, "unnumbered": false, "text": "Pregio non ha, non ha ragion la vita", "html": "Pregio non ha, non ha ragion la vita"}, {"type": "l", "n": 81, "id": "c26.v81", "indent": 0, "missing": false, "unnumbered": false, "text": "Se non per lui, per lui ch’all’uomo è tutto;", "html": "Se non per lui, per lui ch’all’uomo è tutto;"}, {"type": "l", "n": 82, "id": "c26.v82", "indent": 0, "missing": false, "unnumbered": false, "text": "Sola discolpa al fato,", "html": "Sola discolpa al fato,"}, {"type": "l", "n": 83, "id": "c26.v83", "indent": 0, "missing": false, "unnumbered": false, "text": "Che noi mortali in terra", "html": "Che noi mortali in terra"}, {"type": "l", "n": 84, "id": "c26.v84", "indent": 0, "missing": false, "unnumbered": false, "text": "Pose a tanto patir senz’altro frutto;", "html": "Pose a tanto patir senz’altro frutto;"}, {"type": "l", "n": 85, "id": "c26.v85", "indent": 0, "missing": false, "unnumbered": false, "text": "Solo per cui talvolta,", "html": "Solo per cui talvolta,"}, {"type": "l", "n": 86, "id": "c26.v86", "indent": 0, "missing": false, "unnumbered": false, "text": "Non alla gente stolta, al cor non vile", "html": "Non alla gente stolta, al cor non vile"}, {"type": "l", "n": 87, "id": "c26.v87", "indent": 0, "missing": false, "unnumbered": false, "text": "La vita della morte è più gentile.", "html": "La vita della morte è più gentile."}], [{"type": "l", "n": 88, "id": "c26.v88", "indent": 0, "missing": false, "unnumbered": false, "text": "Per còr le gioie tue, dolce pensiero,", "html": "Per còr le gioie tue, dolce pensiero,"}, {"type": "l", "n": 89, "id": "c26.v89", "indent": 0, "missing": false, "unnumbered": false, "text": "Provar gli umani affanni,", "html": "Provar gli umani affanni,"}, {"type": "l", "n": 90, "id": "c26.v90", "indent": 0, "missing": false, "unnumbered": false, "text": "E sostener molt’anni", "html": "E sostener molt’anni"}, {"type": "l", "n": 91, "id": "c26.v91", "indent": 0, "missing": false, "unnumbered": false, "text": "Questa vita mortal, fu non indegno;", "html": "Questa vita mortal, fu non indegno;"}, {"type": "l", "n": 92, "id": "c26.v92", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed ancor tornerei,", "html": "Ed ancor tornerei,"}, {"type": "l", "n": 93, "id": "c26.v93", "indent": 0, "missing": false, "unnumbered": false, "text": "Così qual son de’ nostri mali esperto,", "html": "Così qual son de’ nostri mali esperto,"}, {"type": "l", "n": 94, "id": "c26.v94", "indent": 0, "missing": false, "unnumbered": false, "text": "Verso un tal segno a incominciare il corso:", "html": "Verso un tal segno a incominciare il corso:"}, {"type": "l", "n": 95, "id": "c26.v95", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tra le sabbie e tra il vipereo morso,", "html": "Che tra le sabbie e tra il vipereo morso,"}, {"type": "l", "n": 96, "id": "c26.v96", "indent": 0, "missing": false, "unnumbered": false, "text": "Giammai finor sì stanco", "html": "Giammai finor sì stanco"}, {"type": "l", "n": 97, "id": "c26.v97", "indent": 0, "missing": false, "unnumbered": false, "text": "Per lo mortal deserto", "html": "Per lo mortal deserto"}, {"type": "l", "n": 98, "id": "c26.v98", "indent": 0, "missing": false, "unnumbered": false, "text": "Non venni a te, che queste nostre pene", "html": "Non venni a te, che queste nostre pene"}, {"type": "l", "n": 99, "id": "c26.v99", "indent": 0, "missing": false, "unnumbered": false, "text": "Vincer non mi paresse un tanto bene.", "html": "Vincer non mi paresse un tanto bene."}], [{"type": "l", "n": 100, "id": "c26.v100", "indent": 0, "missing": false, "unnumbered": false, "text": "Che mondo mai, che nova", "html": "Che mondo mai, che nova"}, {"type": "l", "n": 101, "id": "c26.v101", "indent": 0, "missing": false, "unnumbered": false, "text": "Immensità, che paradiso è quello", "html": "Immensità, che paradiso è quello"}, {"type": "l", "n": 102, "id": "c26.v102", "indent": 0, "missing": false, "unnumbered": false, "text": "Là dove spesso il tuo stupendo incanto", "html": "Là dove spesso il tuo stupendo incanto"}, {"type": "l", "n": 103, "id": "c26.v103", "indent": 0, "missing": false, "unnumbered": false, "text": "Parmi innalzar! dov’io,", "html": "Parmi innalzar! dov’io,"}, {"type": "l", "n": 104, "id": "c26.v104", "indent": 0, "missing": false, "unnumbered": false, "text": "Sott’altra luce che l’usata errando,", "html": "Sott’altra luce che l’usata errando,"}, {"type": "l", "n": 105, "id": "c26.v105", "indent": 0, "missing": false, "unnumbered": false, "text": "Il mio terreno stato", "html": "Il mio terreno stato"}, {"type": "l", "n": 106, "id": "c26.v106", "indent": 0, "missing": false, "unnumbered": false, "text": "E tutto quanto il ver pongo in obblio!", "html": "E tutto quanto il ver pongo in obblio!"}, {"type": "l", "n": 107, "id": "c26.v107", "indent": 0, "missing": false, "unnumbered": false, "text": "Tali son, credo, i sogni", "html": "Tali son, credo, i sogni"}, {"type": "l", "n": 108, "id": "c26.v108", "indent": 0, "missing": false, "unnumbered": false, "text": "Degl’immortali. Ahi finalmente un sogno", "html": "Degl’immortali. Ahi finalmente un sogno"}, {"type": "l", "n": 109, "id": "c26.v109", "indent": 0, "missing": false, "unnumbered": false, "text": "In molta parte onde s’abbella il vero", "html": "In molta parte onde s’abbella il vero"}, {"type": "l", "n": 110, "id": "c26.v110", "indent": 0, "missing": false, "unnumbered": false, "text": "Sei tu, dolce pensiero;", "html": "Sei tu, dolce pensiero;"}, {"type": "l", "n": 111, "id": "c26.v111", "indent": 0, "missing": false, "unnumbered": false, "text": "Sogno e palese error. Ma di natura,", "html": "Sogno e palese error. Ma di natura,"}, {"type": "l", "n": 112, "id": "c26.v112", "indent": 0, "missing": false, "unnumbered": false, "text": "Infra i leggiadri errori,", "html": "Infra i leggiadri errori,"}, {"type": "l", "n": 113, "id": "c26.v113", "indent": 0, "missing": false, "unnumbered": false, "text": "Divina sei; perchè sì viva e forte,", "html": "Divina sei; perchè sì viva e forte,"}, {"type": "l", "n": 114, "id": "c26.v114", "indent": 0, "missing": false, "unnumbered": false, "text": "Che incontro al ver tenacemente dura,", "html": "Che incontro al ver tenacemente dura,"}, {"type": "l", "n": 115, "id": "c26.v115", "indent": 0, "missing": false, "unnumbered": false, "text": "E spesso al ver s’adegua,", "html": "E spesso al ver s’adegua,"}, {"type": "l", "n": 116, "id": "c26.v116", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè si dilegua pria, che in grembo a morte.", "html": "Nè si dilegua pria, che in grembo a morte."}], [{"type": "l", "n": 117, "id": "c26.v117", "indent": 0, "missing": false, "unnumbered": false, "text": "E tu per certo, o mio pensier, tu solo", "html": "E tu per certo, o mio pensier, tu solo"}, {"type": "l", "n": 118, "id": "c26.v118", "indent": 0, "missing": false, "unnumbered": false, "text": "Vitale ai giorni miei,", "html": "Vitale ai giorni miei,"}, {"type": "l", "n": 119, "id": "c26.v119", "indent": 0, "missing": false, "unnumbered": false, "text": "Cagion diletta d’infiniti affanni,", "html": "Cagion diletta d’infiniti affanni,"}, {"type": "l", "n": 120, "id": "c26.v120", "indent": 0, "missing": false, "unnumbered": false, "text": "Meco sarai per morte a un tempo spento:", "html": "Meco sarai per morte a un tempo spento:"}, {"type": "l", "n": 121, "id": "c26.v121", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’a vivi segni dentro l’alma io sento", "html": "Ch’a vivi segni dentro l’alma io sento"}, {"type": "l", "n": 122, "id": "c26.v122", "indent": 0, "missing": false, "unnumbered": false, "text": "Che in perpetuo signor dato mi sei.", "html": "Che in perpetuo signor dato mi sei."}, {"type": "l", "n": 123, "id": "c26.v123", "indent": 0, "missing": false, "unnumbered": false, "text": "Altri gentili inganni", "html": "Altri gentili inganni"}, {"type": "l", "n": 124, "id": "c26.v124", "indent": 0, "missing": false, "unnumbered": false, "text": "Soleami il vero aspetto", "html": "Soleami il vero aspetto"}, {"type": "l", "n": 125, "id": "c26.v125", "indent": 0, "missing": false, "unnumbered": false, "text": "Più sempre infievolir. Quanto più torno", "html": "Più sempre infievolir. Quanto più torno"}, {"type": "l", "n": 126, "id": "c26.v126", "indent": 0, "missing": false, "unnumbered": false, "text": "A riveder colei", "html": "A riveder colei"}, {"type": "l", "n": 127, "id": "c26.v127", "indent": 0, "missing": false, "unnumbered": false, "text": "Della qual teco ragionando io vivo,", "html": "Della qual teco ragionando io vivo,"}, {"type": "l", "n": 128, "id": "c26.v128", "indent": 0, "missing": false, "unnumbered": false, "text": "Cresce quel gran diletto,", "html": "Cresce quel gran diletto,"}, {"type": "l", "n": 129, "id": "c26.v129", "indent": 0, "missing": false, "unnumbered": false, "text": "Cresce quel gran delirio, ond’io respiro.", "html": "Cresce quel gran delirio, ond’io respiro."}, {"type": "l", "n": 130, "id": "c26.v130", "indent": 0, "missing": false, "unnumbered": false, "text": "Angelica beltade!", "html": "Angelica beltade!"}, {"type": "l", "n": 131, "id": "c26.v131", "indent": 0, "missing": false, "unnumbered": false, "text": "Parmi ogni più bel volto, ovunque io miro,", "html": "Parmi ogni più bel volto, ovunque io miro,"}, {"type": "l", "n": 132, "id": "c26.v132", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi una finta imago", "html": "Quasi una finta imago"}, {"type": "l", "n": 133, "id": "c26.v133", "indent": 0, "missing": false, "unnumbered": false, "text": "Il tuo volto imitar. Tu sola fonte", "html": "Il tuo volto imitar. Tu sola fonte"}, {"type": "l", "n": 134, "id": "c26.v134", "indent": 0, "missing": false, "unnumbered": false, "text": "D’ogni altra leggiadria,", "html": "D’ogni altra leggiadria,"}, {"type": "l", "n": 135, "id": "c26.v135", "indent": 0, "missing": false, "unnumbered": false, "text": "Sola vera beltà parmi che sia.", "html": "Sola vera beltà parmi che sia."}], [{"type": "l", "n": 136, "id": "c26.v136", "indent": 0, "missing": false, "unnumbered": false, "text": "Da che ti vidi pria,", "html": "Da che ti vidi pria,"}, {"type": "l", "n": 137, "id": "c26.v137", "indent": 0, "missing": false, "unnumbered": false, "text": "Di qual mia seria cura ultimo obbietto", "html": "Di qual mia seria cura ultimo obbietto"}, {"type": "l", "n": 138, "id": "c26.v138", "indent": 0, "missing": false, "unnumbered": false, "text": "Non fosti tu? quanto del giorno è scorso,", "html": "Non fosti tu? quanto del giorno è scorso,"}, {"type": "l", "n": 139, "id": "c26.v139", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’io di te non pensassi? ai sogni miei", "html": "Ch’io di te non pensassi? ai sogni miei"}, {"type": "l", "n": 140, "id": "c26.v140", "indent": 0, "missing": false, "unnumbered": false, "text": "La tua sovrana imago", "html": "La tua sovrana imago"}, {"type": "l", "n": 141, "id": "c26.v141", "indent": 0, "missing": false, "unnumbered": false, "text": "Quante volte mancò? Bella qual sogno,", "html": "Quante volte mancò? Bella qual sogno,"}, {"type": "l", "n": 142, "id": "c26.v142", "indent": 0, "missing": false, "unnumbered": false, "text": "Angelica sembianza,", "html": "Angelica sembianza,"}, {"type": "l", "n": 143, "id": "c26.v143", "indent": 0, "missing": false, "unnumbered": false, "text": "Nella terrena stanza,", "html": "Nella terrena stanza,"}, {"type": "l", "n": 144, "id": "c26.v144", "indent": 0, "missing": false, "unnumbered": false, "text": "Nell’alte vie dell’universo intero,", "html": "Nell’alte vie dell’universo intero,"}, {"type": "l", "n": 145, "id": "c26.v145", "indent": 0, "missing": false, "unnumbered": false, "text": "Che chiedo io mai, che spero", "html": "Che chiedo io mai, che spero"}, {"type": "l", "n": 146, "id": "c26.v146", "indent": 0, "missing": false, "unnumbered": false, "text": "Altro che gli occhi tuoi veder più vago?", "html": "Altro che gli occhi tuoi veder più vago?"}, {"type": "l", "n": 147, "id": "c26.v147", "indent": 0, "missing": false, "unnumbered": false, "text": "Altro più dolce aver che il tuo pensiero?", "html": "Altro più dolce aver che il tuo pensiero?"}]]}
