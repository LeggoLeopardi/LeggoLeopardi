{"n": 36, "roman": "XXXVI", "title": "Scherzo", "slug": "scherzo", "incipit": "Quando fanciullo io venni", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXVI._SCHERZO._p._159"]}, "head": ["XXXVI.", "SCHERZO."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c36.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando fanciullo io venni", "html": "Quando fanciullo io venni"}, {"type": "l", "n": 2, "id": "c36.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "A pormi con le Muse in disciplina,", "html": "A pormi con le Muse in disciplina,"}, {"type": "l", "n": 3, "id": "c36.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "L’una di quelle mi pigliò per mano;", "html": "L’una di quelle mi pigliò per mano;"}, {"type": "l", "n": 4, "id": "c36.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "E poi tutto quel giorno", "html": "E poi tutto quel giorno"}, {"type": "l", "n": 5, "id": "c36.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "La mi condusse intorno", "html": "La mi condusse intorno"}, {"type": "l", "n": 6, "id": "c36.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "A veder l’officina.", "html": "A veder l’officina."}, {"type": "l", "n": 7, "id": "c36.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Mostrommi a parte a parte", "html": "Mostrommi a parte a parte"}, {"type": "l", "n": 8, "id": "c36.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Gli strumenti dell’arte,", "html": "Gli strumenti dell’arte,"}, {"type": "l", "n": 9, "id": "c36.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "E i servigi diversi", "html": "E i servigi diversi"}, {"type": "l", "n": 10, "id": "c36.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "A che ciascun di loro", "html": "A che ciascun di loro"}, {"type": "l", "n": 11, "id": "c36.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "S’adopra nel lavoro", "html": "S’adopra nel lavoro"}, {"type": "l", "n": 12, "id": "c36.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Delle prose e de’ versi.", "html": "Delle prose e de’ versi."}, {"type": "l", "n": 13, "id": "c36.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Io mirava, e chiedea:", "html": "Io mirava, e chiedea:"}, {"type": "l", "n": 14, "id": "c36.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Musa, la lima ov’è? Disse la Dea:", "html": "Musa, la lima ov’è? Disse la Dea:"}, {"type": "l", "n": 15, "id": "c36.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "La lima è consumata; or facciam senza.", "html": "La lima è consumata; or facciam senza."}, {"type": "l", "n": 16, "id": "c36.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed io, ma di rifarla", "html": "Ed io, ma di rifarla"}, {"type": "l", "n": 17, "id": "c36.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Non vi cal, soggiungea, quand’ella è stanca?", "html": "Non vi cal, soggiungea, quand’ella è stanca?"}, {"type": "l", "n": 18, "id": "c36.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Rispose: hassi a rifar, ma il tempo manca.", "html": "Rispose: hassi a rifar, ma il tempo manca."}]]}
