{"n": 40, "roman": "XL", "title": "Dal greco di Simonide", "slug": "dal-greco-di-simonide", "incipit": "Ogni mondano evento", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XL._%E2%80%96_DAL_GRECO_DI_SIMONIDE._p._167", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XL._%E2%80%96_DAL_GRECO_DI_SIMONIDE._p._168"]}, "head": ["XL.", "DAL GRECO DI SIMONIDE."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c40.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni mondano evento", "html": "Ogni mondano evento"}, {"type": "l", "n": 2, "id": "c40.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "È di Giove in poter, di Giove, o figlio,", "html": "È di Giove in poter, di Giove, o figlio,"}, {"type": "l", "n": 3, "id": "c40.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Che giusta suo talento", "html": "Che giusta suo talento"}, {"type": "l", "n": 4, "id": "c40.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni cosa dispone.", "html": "Ogni cosa dispone."}, {"type": "l", "n": 5, "id": "c40.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma di lunga stagione", "html": "Ma di lunga stagione"}, {"type": "l", "n": 6, "id": "c40.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Nostro cieco pensier s’affanna e cura,", "html": "Nostro cieco pensier s’affanna e cura,"}, {"type": "l", "n": 7, "id": "c40.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Benchè l’umana etate,", "html": "Benchè l’umana etate,"}, {"type": "l", "n": 8, "id": "c40.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Come destina il ciel nostra ventura,", "html": "Come destina il ciel nostra ventura,"}, {"type": "l", "n": 9, "id": "c40.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Di giorno in giorno dura.", "html": "Di giorno in giorno dura."}, {"type": "l", "n": 10, "id": "c40.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "La bella speme tutti ci nutrica", "html": "La bella speme tutti ci nutrica"}, {"type": "l", "n": 11, "id": "c40.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Di sembianze beate,", "html": "Di sembianze beate,"}, {"type": "l", "n": 12, "id": "c40.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Onde ciascuno indarno s’affatica:", "html": "Onde ciascuno indarno s’affatica:"}, {"type": "l", "n": 13, "id": "c40.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Altri l’aurora amica,", "html": "Altri l’aurora amica,"}, {"type": "l", "n": 14, "id": "c40.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Altri l’etade aspetta;", "html": "Altri l’etade aspetta;"}, {"type": "l", "n": 15, "id": "c40.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "E nullo in terra vive", "html": "E nullo in terra vive"}, {"type": "l", "n": 16, "id": "c40.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Cui nell’anno avvenir facili e pii", "html": "Cui nell’anno avvenir facili e pii"}, {"type": "l", "n": 17, "id": "c40.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Con Pluto gli altri iddii", "html": "Con Pluto gli altri iddii"}, {"type": "l", "n": 18, "id": "c40.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "La mente non prometta.", "html": "La mente non prometta."}, {"type": "l", "n": 19, "id": "c40.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Ecco pria che la speme in porto arrive,", "html": "Ecco pria che la speme in porto arrive,"}, {"type": "l", "n": 20, "id": "c40.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Qual da vecchiezza è giunto", "html": "Qual da vecchiezza è giunto"}, {"type": "l", "n": 21, "id": "c40.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "E qual da morbi al bruno Lete addutto;", "html": "E qual da morbi al bruno Lete addutto;"}, {"type": "l", "n": 22, "id": "c40.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo il rigido Marte, e quello il flutto", "html": "Questo il rigido Marte, e quello il flutto"}, {"type": "l", "n": 23, "id": "c40.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Del pelago rapisce; altri consunto", "html": "Del pelago rapisce; altri consunto"}, {"type": "l", "n": 24, "id": "c40.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Da negre cure, o tristo nodo al collo", "html": "Da negre cure, o tristo nodo al collo"}, {"type": "l", "n": 25, "id": "c40.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Circondando, sotterra si rifugge.", "html": "Circondando, sotterra si rifugge."}, {"type": "l", "n": 26, "id": "c40.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Così di mille mali", "html": "Così di mille mali"}, {"type": "l", "n": 27, "id": "c40.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "I miseri mortali", "html": "I miseri mortali"}, {"type": "l", "n": 28, "id": "c40.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Volgo fiero e diverso agita e strugge.", "html": "Volgo fiero e diverso agita e strugge."}, {"type": "l", "n": 29, "id": "c40.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma per sentenza mia,", "html": "Ma per sentenza mia,"}, {"type": "l", "n": 30, "id": "c40.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Uom saggio e sciolto dal comune errore", "html": "Uom saggio e sciolto dal comune errore"}, {"type": "l", "n": 31, "id": "c40.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Patir non sosterria,", "html": "Patir non sosterria,"}, {"type": "l", "n": 32, "id": "c40.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè porrebbe al dolore", "html": "Nè porrebbe al dolore"}, {"type": "l", "n": 33, "id": "c40.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed al mal proprio suo cotanto amore.", "html": "Ed al mal proprio suo cotanto amore."}]]}
