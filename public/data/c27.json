{"n": 27, "roman": "XXVII", "title": "Amore e morte", "slug": "amore-e-morte", "incipit": "Fratelli, a un tempo stesso, Amore e Morte", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._127", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._128", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._129", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._130", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._131", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVII._%E2%80%96_AMORE_E_MORTE._p._132"]}, "head": ["XXVII.", "AMORE E MORTE."], "epigraph": ["Ὃν οἱ θεοί φιλοῦσιν, ἀποθνήσκει νέος.", "Muor giovane colui ch’al cielo è caro.", "menandro."], "stanzas": [[{"type": "l", "n": 1, "id": "c27.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Fratelli, a un tempo stesso, Amore e Morte", "html": "Fratelli, a un tempo stesso, Amore e Morte"}, {"type": "l", "n": 2, "id": "c27.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Ingenerò la sorte.", "html": "Ingenerò la sorte."}, {"type": "l", "n": 3, "id": "c27.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Cose quaggiù sì belle", "html": "Cose quaggiù sì belle"}, {"type": "l", "n": 4, "id": "c27.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Altre il mondo non ha, non han le stelle.", "html": "Altre il mondo non ha, non han le stelle."}, {"type": "l", "n": 5, "id": "c27.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Nasce dall’uno il bene,", "html": "Nasce dall’uno il bene,"}, {"type": "l", "n": 6, "id": "c27.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Nasce il piacer maggiore", "html": "Nasce il piacer maggiore"}, {"type": "l", "n": 7, "id": "c27.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Che per lo mar dell’essere si trova;", "html": "Che per lo mar dell’essere si trova;"}, {"type": "l", "n": 8, "id": "c27.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "L’altra ogni gran dolore,", "html": "L’altra ogni gran dolore,"}, {"type": "l", "n": 9, "id": "c27.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni gran male annulla.", "html": "Ogni gran male annulla."}, {"type": "l", "n": 10, "id": "c27.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Bellissima fanciulla,", "html": "Bellissima fanciulla,"}, {"type": "l", "n": 11, "id": "c27.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Dolce a veder, non quale", "html": "Dolce a veder, non quale"}, {"type": "l", "n": 12, "id": "c27.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "La si dipinge la codarda gente,", "html": "La si dipinge la codarda gente,"}, {"type": "l", "n": 13, "id": "c27.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Gode il fanciullo Amore", "html": "Gode il fanciullo Amore"}, {"type": "l", "n": 14, "id": "c27.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Accompagnar sovente;", "html": "Accompagnar sovente;"}, {"type": "l", "n": 15, "id": "c27.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "E sorvolano insiem la via mortale,", "html": "E sorvolano insiem la via mortale,"}, {"type": "l", "n": 16, "id": "c27.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Primi conforti d’ogni saggio core.", "html": "Primi conforti d’ogni saggio core."}, {"type": "l", "n": 17, "id": "c27.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè cor fu mai più saggio", "html": "Nè cor fu mai più saggio"}, {"type": "l", "n": 18, "id": "c27.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Che percosso d’amor, nè mai più forte", "html": "Che percosso d’amor, nè mai più forte"}, {"type": "l", "n": 19, "id": "c27.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Sprezzò l’infausta vita,", "html": "Sprezzò l’infausta vita,"}, {"type": "l", "n": 20, "id": "c27.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè per altro signore", "html": "Nè per altro signore"}, {"type": "l", "n": 21, "id": "c27.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Come per questo a perigliar fu pronto:", "html": "Come per questo a perigliar fu pronto:"}, {"type": "l", "n": 22, "id": "c27.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’ove tu porgi aita,", "html": "Ch’ove tu porgi aita,"}, {"type": "l", "n": 23, "id": "c27.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Amor, nasce il coraggio,", "html": "Amor, nasce il coraggio,"}, {"type": "l", "n": 24, "id": "c27.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "O si ridesta; e sapiente in opre,", "html": "O si ridesta; e sapiente in opre,"}, {"type": "l", "n": 25, "id": "c27.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Non in pensiero invan, siccome suole,", "html": "Non in pensiero invan, siccome suole,"}, {"type": "l", "n": 26, "id": "c27.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Divien l’umana prole.", "html": "Divien l’umana prole."}], [{"type": "l", "n": 27, "id": "c27.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando novellamente", "html": "Quando novellamente"}, {"type": "l", "n": 28, "id": "c27.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Nasce nel cor profondo", "html": "Nasce nel cor profondo"}, {"type": "l", "n": 29, "id": "c27.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Un amoroso affetto,", "html": "Un amoroso affetto,"}, {"type": "l", "n": 30, "id": "c27.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Languido e stanco insiem con esso in petto", "html": "Languido e stanco insiem con esso in petto"}, {"type": "l", "n": 31, "id": "c27.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Un desiderio di morir si sente:", "html": "Un desiderio di morir si sente:"}, {"type": "l", "n": 32, "id": "c27.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Come, non so: ma tale", "html": "Come, non so: ma tale"}, {"type": "l", "n": 33, "id": "c27.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "D’amor vero e possente è il primo effetto.", "html": "D’amor vero e possente è il primo effetto."}, {"type": "l", "n": 34, "id": "c27.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Forse gli occhi spaura", "html": "Forse gli occhi spaura"}, {"type": "l", "n": 35, "id": "c27.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Allor questo deserto: a se la terra", "html": "Allor questo deserto: a se la terra"}, {"type": "l", "n": 36, "id": "c27.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "Forse il mortale inabitabil fatta", "html": "Forse il mortale inabitabil fatta"}, {"type": "l", "n": 37, "id": "c27.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Vede omai senza quella", "html": "Vede omai senza quella"}, {"type": "l", "n": 38, "id": "c27.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Nova, sola, infinita", "html": "Nova, sola, infinita"}, {"type": "l", "n": 39, "id": "c27.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Felicità che il suo pensier figura:", "html": "Felicità che il suo pensier figura:"}, {"type": "l", "n": 40, "id": "c27.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma per cagion di lei grave procella", "html": "Ma per cagion di lei grave procella"}, {"type": "l", "n": 41, "id": "c27.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Presentendo in suo cor, brama quiete,", "html": "Presentendo in suo cor, brama quiete,"}, {"type": "l", "n": 42, "id": "c27.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Brama raccorsi in porto", "html": "Brama raccorsi in porto"}, {"type": "l", "n": 43, "id": "c27.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Dinanzi al fier disio,", "html": "Dinanzi al fier disio,"}, {"type": "l", "n": 44, "id": "c27.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Che già, rugghiando, intorno intorno oscura.", "html": "Che già, rugghiando, intorno intorno oscura."}], [{"type": "l", "n": 45, "id": "c27.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Poi, quando tutto avvolge", "html": "Poi, quando tutto avvolge"}, {"type": "l", "n": 46, "id": "c27.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "La formidabil possa,", "html": "La formidabil possa,"}, {"type": "l", "n": 47, "id": "c27.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "E fulmina nel cor l’invitta cura,", "html": "E fulmina nel cor l’invitta cura,"}, {"type": "l", "n": 48, "id": "c27.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Quante volte implorata", "html": "Quante volte implorata"}, {"type": "l", "n": 49, "id": "c27.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Con desiderio intenso,", "html": "Con desiderio intenso,"}, {"type": "l", "n": 50, "id": "c27.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Morte, sei tu dall’affannoso amante!", "html": "Morte, sei tu dall’affannoso amante!"}, {"type": "l", "n": 51, "id": "c27.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Quante la sera, e quante,", "html": "Quante la sera, e quante,"}, {"type": "l", "n": 52, "id": "c27.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Abbandonando all’alba il corpo stanco,", "html": "Abbandonando all’alba il corpo stanco,"}, {"type": "l", "n": 53, "id": "c27.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Se beato chiamò s’indi giammai", "html": "Se beato chiamò s’indi giammai"}, {"type": "l", "n": 54, "id": "c27.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Non rilevasse il fianco,", "html": "Non rilevasse il fianco,"}, {"type": "l", "n": 55, "id": "c27.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè tornasse a veder l’amara luce!", "html": "Nè tornasse a veder l’amara luce!"}, {"type": "l", "n": 56, "id": "c27.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "E spesso al suon della funebre squilla,", "html": "E spesso al suon della funebre squilla,"}, {"type": "l", "n": 57, "id": "c27.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "Al canto che conduce", "html": "Al canto che conduce"}, {"type": "l", "n": 58, "id": "c27.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "La gente morta al sempiterno obblio,", "html": "La gente morta al sempiterno obblio,"}, {"type": "l", "n": 59, "id": "c27.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "Con più sospiri ardenti", "html": "Con più sospiri ardenti"}, {"type": "l", "n": 60, "id": "c27.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "Dall’imo petto invidiò colui", "html": "Dall’imo petto invidiò colui"}, {"type": "l", "n": 61, "id": "c27.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tra gli spenti ad abitar sen giva.", "html": "Che tra gli spenti ad abitar sen giva."}, {"type": "l", "n": 62, "id": "c27.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "Fin la negletta plebe,", "html": "Fin la negletta plebe,"}, {"type": "l", "n": 63, "id": "c27.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "L’uom della villa, ignaro", "html": "L’uom della villa, ignaro"}, {"type": "l", "n": 64, "id": "c27.v64", "indent": 0, "missing": false, "unnumbered": false, "text": "D’ogni virtù che da saper deriva,", "html": "D’ogni virtù che da saper deriva,"}, {"type": "l", "n": 65, "id": "c27.v65", "indent": 0, "missing": false, "unnumbered": false, "text": "Fin la donzella timidetta e schiva,", "html": "Fin la donzella timidetta e schiva,"}, {"type": "l", "n": 66, "id": "c27.v66", "indent": 0, "missing": false, "unnumbered": false, "text": "Che già di morte al nome", "html": "Che già di morte al nome"}, {"type": "l", "n": 67, "id": "c27.v67", "indent": 0, "missing": false, "unnumbered": false, "text": "Sentì rizzar le chiome,", "html": "Sentì rizzar le chiome,"}, {"type": "l", "n": 68, "id": "c27.v68", "indent": 0, "missing": false, "unnumbered": false, "text": "Osa alla tomba, alle funeree bende", "html": "Osa alla tomba, alle funeree bende"}, {"type": "l", "n": 69, "id": "c27.v69", "indent": 0, "missing": false, "unnumbered": false, "text": "Fermar lo sguardo di costanza pieno,", "html": "Fermar lo sguardo di costanza pieno,"}, {"type": "l", "n": 70, "id": "c27.v70", "indent": 0, "missing": false, "unnumbered": false, "text": "Osa ferro e veleno", "html": "Osa ferro e veleno"}, {"type": "l", "n": 71, "id": "c27.v71", "indent": 0, "missing": false, "unnumbered": false, "text": "Meditar lungamente,", "html": "Meditar lungamente,"}, {"type": "l", "n": 72, "id": "c27.v72", "indent": 0, "missing": false, "unnumbered": false, "text": "E nell’indotta mente", "html": "E nell’indotta mente"}, {"type": "l", "n": 73, "id": "c27.v73", "indent": 0, "missing": false, "unnumbered": false, "text": "La gentilezza del morir comprende.", "html": "La gentilezza del morir comprende."}, {"type": "l", "n": 74, "id": "c27.v74", "indent": 0, "missing": false, "unnumbered": false, "text": "Tanto alla morte inclina", "html": "Tanto alla morte inclina"}, {"type": "l", "n": 75, "id": "c27.v75", "indent": 0, "missing": false, "unnumbered": false, "text": "D’amor la disciplina. Anco sovente,", "html": "D’amor la disciplina. Anco sovente,"}, {"type": "l", "n": 76, "id": "c27.v76", "indent": 0, "missing": false, "unnumbered": false, "text": "A tal venuto il gran travaglio interno", "html": "A tal venuto il gran travaglio interno"}, {"type": "l", "n": 77, "id": "c27.v77", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sostener nol può forza mortale,", "html": "Che sostener nol può forza mortale,"}, {"type": "l", "n": 78, "id": "c27.v78", "indent": 0, "missing": false, "unnumbered": false, "text": "O cede il corpo frale", "html": "O cede il corpo frale"}, {"type": "l", "n": 79, "id": "c27.v79", "indent": 0, "missing": false, "unnumbered": false, "text": "Ai terribili moti, e in questa forma", "html": "Ai terribili moti, e in questa forma"}, {"type": "l", "n": 80, "id": "c27.v80", "indent": 0, "missing": false, "unnumbered": false, "text": "Pel fraterno poter Morte prevale;", "html": "Pel fraterno poter Morte prevale;"}, {"type": "l", "n": 81, "id": "c27.v81", "indent": 0, "missing": false, "unnumbered": false, "text": "O così sprona Amor là nel profondo,", "html": "O così sprona Amor là nel profondo,"}, {"type": "l", "n": 82, "id": "c27.v82", "indent": 0, "missing": false, "unnumbered": false, "text": "Che da se stessi il villanello ignaro,", "html": "Che da se stessi il villanello ignaro,"}, {"type": "l", "n": 83, "id": "c27.v83", "indent": 0, "missing": false, "unnumbered": false, "text": "La tenera donzella", "html": "La tenera donzella"}, {"type": "l", "n": 84, "id": "c27.v84", "indent": 0, "missing": false, "unnumbered": false, "text": "Con la man violenta", "html": "Con la man violenta"}, {"type": "l", "n": 85, "id": "c27.v85", "indent": 0, "missing": false, "unnumbered": false, "text": "Pongon le membra giovanili in terra.", "html": "Pongon le membra giovanili in terra."}, {"type": "l", "n": 86, "id": "c27.v86", "indent": 0, "missing": false, "unnumbered": false, "text": "Ride ai lor casi il mondo,", "html": "Ride ai lor casi il mondo,"}, {"type": "l", "n": 87, "id": "c27.v87", "indent": 0, "missing": false, "unnumbered": false, "text": "A cui pace e vecchiezza il ciel consenta.", "html": "A cui pace e vecchiezza il ciel consenta."}], [{"type": "l", "n": 88, "id": "c27.v88", "indent": 0, "missing": false, "unnumbered": false, "text": "Ai fervidi, ai felici,", "html": "Ai fervidi, ai felici,"}, {"type": "l", "n": 89, "id": "c27.v89", "indent": 0, "missing": false, "unnumbered": false, "text": "Agli animosi ingegni", "html": "Agli animosi ingegni"}, {"type": "l", "n": 90, "id": "c27.v90", "indent": 0, "missing": false, "unnumbered": false, "text": "L’uno o l’altro di voi conceda il fato,", "html": "L’uno o l’altro di voi conceda il fato,"}, {"type": "l", "n": 91, "id": "c27.v91", "indent": 0, "missing": false, "unnumbered": false, "text": "Dolci signori, amici", "html": "Dolci signori, amici"}, {"type": "l", "n": 92, "id": "c27.v92", "indent": 0, "missing": false, "unnumbered": false, "text": "All’umana famiglia,", "html": "All’umana famiglia,"}, {"type": "l", "n": 93, "id": "c27.v93", "indent": 0, "missing": false, "unnumbered": false, "text": "Al cui poter nessun poter somiglia", "html": "Al cui poter nessun poter somiglia"}, {"type": "l", "n": 94, "id": "c27.v94", "indent": 0, "missing": false, "unnumbered": false, "text": "Nell’immenso universo, e non l’avanza,", "html": "Nell’immenso universo, e non l’avanza,"}, {"type": "l", "n": 95, "id": "c27.v95", "indent": 0, "missing": false, "unnumbered": false, "text": "Se non quella del fato, altra possanza.", "html": "Se non quella del fato, altra possanza."}, {"type": "l", "n": 96, "id": "c27.v96", "indent": 0, "missing": false, "unnumbered": false, "text": "E tu, cui già dal cominciar degli anni", "html": "E tu, cui già dal cominciar degli anni"}, {"type": "l", "n": 97, "id": "c27.v97", "indent": 0, "missing": false, "unnumbered": false, "text": "Sempre onorata invoco,", "html": "Sempre onorata invoco,"}, {"type": "l", "n": 98, "id": "c27.v98", "indent": 0, "missing": false, "unnumbered": false, "text": "Bella Morte, pietosa", "html": "Bella Morte, pietosa"}, {"type": "l", "n": 99, "id": "c27.v99", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu sola al mondo dei terreni affanni,", "html": "Tu sola al mondo dei terreni affanni,"}, {"type": "l", "n": 100, "id": "c27.v100", "indent": 0, "missing": false, "unnumbered": false, "text": "Se celebrata mai", "html": "Se celebrata mai"}, {"type": "l", "n": 101, "id": "c27.v101", "indent": 0, "missing": false, "unnumbered": false, "text": "Fosti da me, s’al tuo divino stato", "html": "Fosti da me, s’al tuo divino stato"}, {"type": "l", "n": 102, "id": "c27.v102", "indent": 0, "missing": false, "unnumbered": false, "text": "L’onte del volgo ingrato", "html": "L’onte del volgo ingrato"}, {"type": "l", "n": 103, "id": "c27.v103", "indent": 0, "missing": false, "unnumbered": false, "text": "Ricompensar tentai,", "html": "Ricompensar tentai,"}, {"type": "l", "n": 104, "id": "c27.v104", "indent": 0, "missing": false, "unnumbered": false, "text": "Non tardar più, t’inchina", "html": "Non tardar più, t’inchina"}, {"type": "l", "n": 105, "id": "c27.v105", "indent": 0, "missing": false, "unnumbered": false, "text": "A disusati preghi,", "html": "A disusati preghi,"}, {"type": "l", "n": 106, "id": "c27.v106", "indent": 0, "missing": false, "unnumbered": false, "text": "Chiudi alla luce omai", "html": "Chiudi alla luce omai"}, {"type": "l", "n": 107, "id": "c27.v107", "indent": 0, "missing": false, "unnumbered": false, "text": "Questi occhi tristi, o dell’età reina.", "html": "Questi occhi tristi, o dell’età reina."}, {"type": "l", "n": 108, "id": "c27.v108", "indent": 0, "missing": false, "unnumbered": false, "text": "Me certo troverai, qual si sia l’ora", "html": "Me certo troverai, qual si sia l’ora"}, {"type": "l", "n": 109, "id": "c27.v109", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tu le penne al mio pregar dispieghi,", "html": "Che tu le penne al mio pregar dispieghi,"}, {"type": "l", "n": 110, "id": "c27.v110", "indent": 0, "missing": false, "unnumbered": false, "text": "Erta la fronte, armato,", "html": "Erta la fronte, armato,"}, {"type": "l", "n": 111, "id": "c27.v111", "indent": 0, "missing": false, "unnumbered": false, "text": "E renitente al fato,", "html": "E renitente al fato,"}, {"type": "l", "n": 112, "id": "c27.v112", "indent": 0, "missing": false, "unnumbered": false, "text": "La man che flagellando si colora", "html": "La man che flagellando si colora"}, {"type": "l", "n": 113, "id": "c27.v113", "indent": 0, "missing": false, "unnumbered": false, "text": "Nel mio sangue innocente", "html": "Nel mio sangue innocente"}, {"type": "l", "n": 114, "id": "c27.v114", "indent": 0, "missing": false, "unnumbered": false, "text": "Non ricolmar di lode,", "html": "Non ricolmar di lode,"}, {"type": "l", "n": 115, "id": "c27.v115", "indent": 0, "missing": false, "unnumbered": false, "text": "Non benedir, com’usa", "html": "Non benedir, com’usa"}, {"type": "l", "n": 116, "id": "c27.v116", "indent": 0, "missing": false, "unnumbered": false, "text": "Per antica viltà l’umana gente;", "html": "Per antica viltà l’umana gente;"}, {"type": "l", "n": 117, "id": "c27.v117", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni vana speranza onde consola", "html": "Ogni vana speranza onde consola"}, {"type": "l", "n": 118, "id": "c27.v118", "indent": 0, "missing": false, "unnumbered": false, "text": "Se coi fanciulli il mondo,", "html": "Se coi fanciulli il mondo,"}, {"type": "l", "n": 119, "id": "c27.v119", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni conforto stolto", "html": "Ogni conforto stolto"}, {"type": "l", "n": 120, "id": "c27.v120", "indent": 0, "missing": false, "unnumbered": false, "text": "Gittar da me; null’altro in alcun tempo", "html": "Gittar da me; null’altro in alcun tempo"}, {"type": "l", "n": 121, "id": "c27.v121", "indent": 0, "missing": false, "unnumbered": false, "text": "Sperar, se non te sola;", "html": "Sperar, se non te sola;"}, {"type": "l", "n": 122, "id": "c27.v122", "indent": 0, "missing": false, "unnumbered": false, "text": "Solo aspettar sereno", "html": "Solo aspettar sereno"}, {"type": "l", "n": 123, "id": "c27.v123", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel dì ch’io pieghi addormentato il volto", "html": "Quel dì ch’io pieghi addormentato il volto"}, {"type": "l", "n": 124, "id": "c27.v124", "indent": 0, "missing": false, "unnumbered": false, "text": "Nel tuo virgineo seno.", "html": "Nel tuo virgineo seno."}]]}
