{"n": 21, "roman": "XXI", "title": "A Silvia", "slug": "a-silvia", "incipit": "Silvia, rimembri ancora", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXI._%E2%80%96_A_SILVIA._p._98", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXI._%E2%80%96_A_SILVIA._p._99", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXI._%E2%80%96_A_SILVIA._p._100"]}, "head": ["XXI.", "A SILVIA."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c21.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Silvia, rimembri ancora", "html": "Silvia, rimembri ancora"}, {"type": "l", "n": 2, "id": "c21.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel tempo della tua vita mortale,", "html": "Quel tempo della tua vita mortale,"}, {"type": "l", "n": 3, "id": "c21.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando beltà splendea", "html": "Quando beltà splendea"}, {"type": "l", "n": 4, "id": "c21.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Negli occhi tuoi ridenti e fuggitivi,", "html": "Negli occhi tuoi ridenti e fuggitivi,"}, {"type": "l", "n": 5, "id": "c21.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "E tu, lieta e pensosa, il limitare", "html": "E tu, lieta e pensosa, il limitare"}, {"type": "l", "n": 6, "id": "c21.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Di gioventù salivi?", "html": "Di gioventù salivi?"}], [{"type": "l", "n": 7, "id": "c21.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Sonavan le quiete", "html": "Sonavan le quiete"}, {"type": "l", "n": 8, "id": "c21.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Stanze, e le vie dintorno,", "html": "Stanze, e le vie dintorno,"}, {"type": "l", "n": 9, "id": "c21.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Al tuo perpetuo canto,", "html": "Al tuo perpetuo canto,"}, {"type": "l", "n": 10, "id": "c21.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Allor che all'opre femminili intenta", "html": "Allor che all'opre femminili intenta"}, {"type": "l", "n": 11, "id": "c21.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Sedevi, assai contenta", "html": "Sedevi, assai contenta"}, {"type": "l", "n": 12, "id": "c21.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Di quel vago avvenir che in mente avevi.", "html": "Di quel vago avvenir che in mente avevi."}, {"type": "l", "n": 13, "id": "c21.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Era il maggio odoroso: e tu solevi", "html": "Era il maggio odoroso: e tu solevi"}, {"type": "l", "n": 14, "id": "c21.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Così menare il giorno.", "html": "Così menare il giorno."}], [{"type": "l", "n": 15, "id": "c21.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Io gli studi leggiadri", "html": "Io gli studi leggiadri"}, {"type": "l", "n": 16, "id": "c21.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Talor lasciando e le sudate carte,", "html": "Talor lasciando e le sudate carte,"}, {"type": "l", "n": 17, "id": "c21.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Ove il tempo mio primo", "html": "Ove il tempo mio primo"}, {"type": "l", "n": 18, "id": "c21.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "E di me si spendea la miglior parte,", "html": "E di me si spendea la miglior parte,"}, {"type": "l", "n": 19, "id": "c21.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "D’in su i veroni del paterno ostello", "html": "D’in su i veroni del paterno ostello"}, {"type": "l", "n": 20, "id": "c21.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Porgea gli orecchi al suon della tua voce,", "html": "Porgea gli orecchi al suon della tua voce,"}, {"type": "l", "n": 21, "id": "c21.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed alla man veloce", "html": "Ed alla man veloce"}, {"type": "l", "n": 22, "id": "c21.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Che percorrea la faticosa tela.", "html": "Che percorrea la faticosa tela."}, {"type": "l", "n": 23, "id": "c21.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Mirava il ciel sereno,", "html": "Mirava il ciel sereno,"}, {"type": "l", "n": 24, "id": "c21.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Le vie dorate e gli orti,", "html": "Le vie dorate e gli orti,"}, {"type": "l", "n": 25, "id": "c21.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "E quinci il mar da lungi, e quindi il monte.", "html": "E quinci il mar da lungi, e quindi il monte."}, {"type": "l", "n": 26, "id": "c21.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Lingua mortal non dice", "html": "Lingua mortal non dice"}, {"type": "l", "n": 27, "id": "c21.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel ch’io sentiva in seno.", "html": "Quel ch’io sentiva in seno."}], [{"type": "l", "n": 28, "id": "c21.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Che pensieri soavi,", "html": "Che pensieri soavi,"}, {"type": "l", "n": 29, "id": "c21.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Che speranze, che cori, o Silvia mia!", "html": "Che speranze, che cori, o Silvia mia!"}, {"type": "l", "n": 30, "id": "c21.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Quale allor ci apparia", "html": "Quale allor ci apparia"}, {"type": "l", "n": 31, "id": "c21.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "La vita umana e il fato!", "html": "La vita umana e il fato!"}, {"type": "l", "n": 32, "id": "c21.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando sovviemmi di cotanta speme,", "html": "Quando sovviemmi di cotanta speme,"}, {"type": "l", "n": 33, "id": "c21.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Un affetto mi preme", "html": "Un affetto mi preme"}, {"type": "l", "n": 34, "id": "c21.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Acerbo e sconsolato,", "html": "Acerbo e sconsolato,"}, {"type": "l", "n": 35, "id": "c21.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "E tornami a doler di mia sventura.", "html": "E tornami a doler di mia sventura."}, {"type": "l", "n": 36, "id": "c21.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "O natura, o natura,", "html": "O natura, o natura,"}, {"type": "l", "n": 37, "id": "c21.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Perchè non rendi poi", "html": "Perchè non rendi poi"}, {"type": "l", "n": 38, "id": "c21.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel che prometti allor? perchè di tanto", "html": "Quel che prometti allor? perchè di tanto"}, {"type": "l", "n": 39, "id": "c21.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Inganni i figli tuoi?", "html": "Inganni i figli tuoi?"}], [{"type": "l", "n": 40, "id": "c21.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu pria che l’erbe inaridisse il verno,", "html": "Tu pria che l’erbe inaridisse il verno,"}, {"type": "l", "n": 41, "id": "c21.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Da chiuso morbo combattuta e vinta,", "html": "Da chiuso morbo combattuta e vinta,"}, {"type": "l", "n": 42, "id": "c21.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Perivi, o tenerella. E non vedevi", "html": "Perivi, o tenerella. E non vedevi"}, {"type": "l", "n": 43, "id": "c21.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Il fior degli anni tuoi;", "html": "Il fior degli anni tuoi;"}, {"type": "l", "n": 44, "id": "c21.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Non ti molceva il core", "html": "Non ti molceva il core"}, {"type": "l", "n": 45, "id": "c21.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "La dolce lode or delle negre chiome,", "html": "La dolce lode or delle negre chiome,"}, {"type": "l", "n": 46, "id": "c21.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Or degli sguardi innamorati e schivi;", "html": "Or degli sguardi innamorati e schivi;"}, {"type": "l", "n": 47, "id": "c21.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè teco le compagne ai dì festivi", "html": "Nè teco le compagne ai dì festivi"}, {"type": "l", "n": 48, "id": "c21.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Ragionavan d’amore.", "html": "Ragionavan d’amore."}], [{"type": "l", "n": 49, "id": "c21.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Anche peria fra poco", "html": "Anche peria fra poco"}, {"type": "l", "n": 50, "id": "c21.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "La speranza mia dolce: agli anni miei", "html": "La speranza mia dolce: agli anni miei"}, {"type": "l", "n": 51, "id": "c21.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Anche negaro i fati", "html": "Anche negaro i fati"}, {"type": "l", "n": 52, "id": "c21.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "La giovanezza. Ahi come,", "html": "La giovanezza. Ahi come,"}, {"type": "l", "n": 53, "id": "c21.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Come passata sei,", "html": "Come passata sei,"}, {"type": "l", "n": 54, "id": "c21.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Cara compagna dell'età mia nova,", "html": "Cara compagna dell'età mia nova,"}, {"type": "l", "n": 55, "id": "c21.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Mia lacrimata speme!", "html": "Mia lacrimata speme!"}, {"type": "l", "n": 56, "id": "c21.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo è quel mondo? questi", "html": "Questo è quel mondo? questi"}, {"type": "l", "n": 57, "id": "c21.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "I diletti, l’amor, l’opre, gli eventi", "html": "I diletti, l’amor, l’opre, gli eventi"}, {"type": "l", "n": 58, "id": "c21.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "Onde cotanto ragionammo insieme?", "html": "Onde cotanto ragionammo insieme?"}, {"type": "l", "n": 59, "id": "c21.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "Questa la sorte dell'umane genti?", "html": "Questa la sorte dell'umane genti?"}, {"type": "l", "n": 60, "id": "c21.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "All'apparir del vero", "html": "All'apparir del vero"}, {"type": "l", "n": 61, "id": "c21.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu, misera, cadesti: e con la mano", "html": "Tu, misera, cadesti: e con la mano"}, {"type": "l", "n": 62, "id": "c21.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "La fredda morte ed una tomba ignuda", "html": "La fredda morte ed una tomba ignuda"}, {"type": "l", "n": 63, "id": "c21.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "Mostravi di lontano.", "html": "Mostravi di lontano."}]]}
