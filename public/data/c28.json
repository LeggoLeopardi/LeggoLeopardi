{"n": 28, "roman": "XXVIII", "title": "A se stesso", "slug": "a-se-stesso", "incipit": "Or poserai per sempre,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXVIII._A_se_stesso_p._133"]}, "head": ["XXVIII.", "A SE STESSO."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c28.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Or poserai per sempre,", "html": "Or poserai per sempre,"}, {"type": "l", "n": 2, "id": "c28.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Stanco mio cor. Perì l’inganno estremo,", "html": "Stanco mio cor. Perì l’inganno estremo,"}, {"type": "l", "n": 3, "id": "c28.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’eterno io mi credei. Perì. Ben sento,", "html": "Ch’eterno io mi credei. Perì. Ben sento,"}, {"type": "l", "n": 4, "id": "c28.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "In noi di cari inganni,", "html": "In noi di cari inganni,"}, {"type": "l", "n": 5, "id": "c28.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Non che la speme, il desiderio è spento.", "html": "Non che la speme, il desiderio è spento."}, {"type": "l", "n": 6, "id": "c28.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Posa per sempre. Assai", "html": "Posa per sempre. Assai"}, {"type": "l", "n": 7, "id": "c28.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Palpitasti. Non val cosa nessuna", "html": "Palpitasti. Non val cosa nessuna"}, {"type": "l", "n": 8, "id": "c28.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "I moti tuoi, nè di sospiri è degna", "html": "I moti tuoi, nè di sospiri è degna"}, {"type": "l", "n": 9, "id": "c28.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "La terra. Amaro e noia", "html": "La terra. Amaro e noia"}, {"type": "l", "n": 10, "id": "c28.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "La vita, altro mai nulla; e fango è il mondo.", "html": "La vita, altro mai nulla; e fango è il mondo."}, {"type": "l", "n": 11, "id": "c28.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "T’acqueta omai. Dispera", "html": "T’acqueta omai. Dispera"}, {"type": "l", "n": 12, "id": "c28.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "L’ultima volta. Al gener nostro il fato", "html": "L’ultima volta. Al gener nostro il fato"}, {"type": "l", "n": 13, "id": "c28.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Non donò che il morire. Omai disprezza", "html": "Non donò che il morire. Omai disprezza"}, {"type": "l", "n": 14, "id": "c28.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Te, la natura, il brutto", "html": "Te, la natura, il brutto"}, {"type": "l", "n": 15, "id": "c28.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Poter che, ascoso, a comun danno impera,", "html": "Poter che, ascoso, a comun danno impera,"}, {"type": "l", "n": 16, "id": "c28.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "E l’infinita vanità del tutto.", "html": "E l’infinita vanità del tutto."}]]}
