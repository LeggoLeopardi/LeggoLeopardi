{"n": 35, "roman": "XXXV", "title": "Imitazione", "slug": "imitazione", "incipit": "Lungi dal propio ramo,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXV._IMITAZIONE._p._158"]}, "head": ["XXXV.", "IMITAZIONE."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c35.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Lungi dal propio ramo,", "html": "Lungi dal propio ramo,"}, {"type": "l", "n": 2, "id": "c35.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Povera foglia frale,", "html": "Povera foglia frale,"}, {"type": "l", "n": 3, "id": "c35.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Dove vai tu? Dal faggio", "html": "Dove vai tu? Dal faggio"}, {"type": "l", "n": 4, "id": "c35.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Là dov’io nacqui, mi divise il vento.", "html": "Là dov’io nacqui, mi divise il vento."}, {"type": "l", "n": 5, "id": "c35.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Esso, tornando, a volo", "html": "Esso, tornando, a volo"}, {"type": "l", "n": 6, "id": "c35.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Dal bosco alla campagna,", "html": "Dal bosco alla campagna,"}, {"type": "l", "n": 7, "id": "c35.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Dalla valle mi porta alla montagna.", "html": "Dalla valle mi porta alla montagna."}, {"type": "l", "n": 8, "id": "c35.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Seco perpetuamente", "html": "Seco perpetuamente"}, {"type": "l", "n": 9, "id": "c35.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Vo pellegrina, e tutto l’altro ignoro.", "html": "Vo pellegrina, e tutto l’altro ignoro."}, {"type": "l", "n": 10, "id": "c35.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Vo dove ogni altra cosa,", "html": "Vo dove ogni altra cosa,"}, {"type": "l", "n": 11, "id": "c35.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Dove naturalmente", "html": "Dove naturalmente"}, {"type": "l", "n": 12, "id": "c35.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Va la foglia di rosa,", "html": "Va la foglia di rosa,"}, {"type": "l", "n": 13, "id": "c35.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "E la foglia d’alloro.", "html": "E la foglia d’alloro."}]]}
