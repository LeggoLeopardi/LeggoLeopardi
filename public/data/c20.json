{"n": 20, "roman": "XX", "title": "Il risorgimento", "slug": "il-risorgimento", "incipit": "Credei ch’al tutto fossero", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._91", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._92", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._93", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._94", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._95", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._96", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XX._Il_risorgimento_p._97"]}, "head": ["XX.", "IL RISORGIMENTO."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c20.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Credei ch’al tutto fossero", "html": "Credei ch’al tutto fossero"}, {"type": "l", "n": 2, "id": "c20.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "In me, sul fior degli anni,", "html": "In me, sul fior degli anni,"}, {"type": "l", "n": 3, "id": "c20.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Mancati i dolci affanni", "html": "Mancati i dolci affanni"}, {"type": "l", "n": 4, "id": "c20.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Della mia prima età:", "html": "Della mia prima età:"}], [{"type": "l", "n": 5, "id": "c20.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "I dolci affanni, i teneri", "html": "I dolci affanni, i teneri"}, {"type": "l", "n": 6, "id": "c20.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Moti del cor profondo,", "html": "Moti del cor profondo,"}, {"type": "l", "n": 7, "id": "c20.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Qualunque cosa al mondo", "html": "Qualunque cosa al mondo"}, {"type": "l", "n": 8, "id": "c20.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Grato il sentir ci fa.", "html": "Grato il sentir ci fa."}], [{"type": "l", "n": 9, "id": "c20.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Quante querele e lacrime", "html": "Quante querele e lacrime"}, {"type": "l", "n": 10, "id": "c20.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Sparsi nel novo stato,", "html": "Sparsi nel novo stato,"}, {"type": "l", "n": 11, "id": "c20.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando al mio cor gelato", "html": "Quando al mio cor gelato"}, {"type": "l", "n": 12, "id": "c20.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Prima il dolor mancò!", "html": "Prima il dolor mancò!"}], [{"type": "l", "n": 13, "id": "c20.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Mancàr gli usati palpiti,", "html": "Mancàr gli usati palpiti,"}, {"type": "l", "n": 14, "id": "c20.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "L’amor mi venne meno,", "html": "L’amor mi venne meno,"}, {"type": "l", "n": 15, "id": "c20.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "E irrigidito il seno", "html": "E irrigidito il seno"}, {"type": "l", "n": 16, "id": "c20.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Di sospirar cessò!", "html": "Di sospirar cessò!"}], [{"type": "l", "n": 17, "id": "c20.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Piansi spogliata, esanime", "html": "Piansi spogliata, esanime"}, {"type": "l", "n": 18, "id": "c20.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Fatta per me la vita;", "html": "Fatta per me la vita;"}, {"type": "l", "n": 19, "id": "c20.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "La terra inaridita,", "html": "La terra inaridita,"}, {"type": "l", "n": 20, "id": "c20.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Chiusa in eterno gel;", "html": "Chiusa in eterno gel;"}], [{"type": "l", "n": 21, "id": "c20.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Deserto il dì; la tacita", "html": "Deserto il dì; la tacita"}, {"type": "l", "n": 22, "id": "c20.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Notte più sola e bruna;", "html": "Notte più sola e bruna;"}, {"type": "l", "n": 23, "id": "c20.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Spenta per me la luna,", "html": "Spenta per me la luna,"}, {"type": "l", "n": 24, "id": "c20.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Spente le stelle in ciel.", "html": "Spente le stelle in ciel."}], [{"type": "l", "n": 25, "id": "c20.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Pur di quel pianto origine", "html": "Pur di quel pianto origine"}, {"type": "l", "n": 26, "id": "c20.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Era l’antico affetto:", "html": "Era l’antico affetto:"}, {"type": "l", "n": 27, "id": "c20.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Nell’intimo del petto", "html": "Nell’intimo del petto"}, {"type": "l", "n": 28, "id": "c20.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Ancor viveva il cor.", "html": "Ancor viveva il cor."}], [{"type": "l", "n": 29, "id": "c20.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Chiedea l’usate immagini", "html": "Chiedea l’usate immagini"}, {"type": "l", "n": 30, "id": "c20.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "La stanca fantasia;", "html": "La stanca fantasia;"}, {"type": "l", "n": 31, "id": "c20.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "E la tristezza mia", "html": "E la tristezza mia"}, {"type": "l", "n": 32, "id": "c20.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Era dolore ancor.", "html": "Era dolore ancor."}], [{"type": "l", "n": 33, "id": "c20.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Fra poco in me quell’ultimo", "html": "Fra poco in me quell’ultimo"}, {"type": "l", "n": 34, "id": "c20.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Dolore anco fu spento,", "html": "Dolore anco fu spento,"}, {"type": "l", "n": 35, "id": "c20.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "E di più far lamento", "html": "E di più far lamento"}, {"type": "l", "n": 36, "id": "c20.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "Valor non mi restò.", "html": "Valor non mi restò."}], [{"type": "l", "n": 37, "id": "c20.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Giacqui: insensato, attonito,", "html": "Giacqui: insensato, attonito,"}, {"type": "l", "n": 38, "id": "c20.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Non dimandai conforto:", "html": "Non dimandai conforto:"}, {"type": "l", "n": 39, "id": "c20.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi perduto e morto,", "html": "Quasi perduto e morto,"}, {"type": "l", "n": 40, "id": "c20.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Il cor s’abbandonò.", "html": "Il cor s’abbandonò."}], [{"type": "l", "n": 41, "id": "c20.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Qual fui! quanto dissimile", "html": "Qual fui! quanto dissimile"}, {"type": "l", "n": 42, "id": "c20.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Da quel che tanto ardore,", "html": "Da quel che tanto ardore,"}, {"type": "l", "n": 43, "id": "c20.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sì beato errore", "html": "Che sì beato errore"}, {"type": "l", "n": 44, "id": "c20.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Nutrii nell’alma un dì!", "html": "Nutrii nell’alma un dì!"}], [{"type": "l", "n": 45, "id": "c20.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "La rondinella vigile,", "html": "La rondinella vigile,"}, {"type": "l", "n": 46, "id": "c20.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Alle finestre intorno", "html": "Alle finestre intorno"}, {"type": "l", "n": 47, "id": "c20.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Cantando al novo giorno,", "html": "Cantando al novo giorno,"}, {"type": "l", "n": 48, "id": "c20.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Il cor non mi ferì:", "html": "Il cor non mi ferì:"}], [{"type": "l", "n": 49, "id": "c20.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Non all'autunno pallido", "html": "Non all'autunno pallido"}, {"type": "l", "n": 50, "id": "c20.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "In solitaria villa,", "html": "In solitaria villa,"}, {"type": "l", "n": 51, "id": "c20.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "La vespertina squilla,", "html": "La vespertina squilla,"}, {"type": "l", "n": 52, "id": "c20.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Il fuggitivo Sol.", "html": "Il fuggitivo Sol."}], [{"type": "l", "n": 53, "id": "c20.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Invan brillare il vespero", "html": "Invan brillare il vespero"}, {"type": "l", "n": 54, "id": "c20.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Vidi per muto calle,", "html": "Vidi per muto calle,"}, {"type": "l", "n": 55, "id": "c20.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Invan sonò la valle", "html": "Invan sonò la valle"}, {"type": "l", "n": 56, "id": "c20.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Del flebile usignol.", "html": "Del flebile usignol."}], [{"type": "l", "n": 57, "id": "c20.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "E voi, pupille tenere,", "html": "E voi, pupille tenere,"}, {"type": "l", "n": 58, "id": "c20.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "Sguardi furtivi, erranti,", "html": "Sguardi furtivi, erranti,"}, {"type": "l", "n": 59, "id": "c20.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "Voi de’ gentili amanti", "html": "Voi de’ gentili amanti"}, {"type": "l", "n": 60, "id": "c20.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "Primo, immortale amor,", "html": "Primo, immortale amor,"}], [{"type": "l", "n": 61, "id": "c20.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed alla mano offertami", "html": "Ed alla mano offertami"}, {"type": "l", "n": 62, "id": "c20.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "Candida ignuda mano,", "html": "Candida ignuda mano,"}, {"type": "l", "n": 63, "id": "c20.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "Foste voi pure invano", "html": "Foste voi pure invano"}, {"type": "l", "n": 64, "id": "c20.v64", "indent": 0, "missing": false, "unnumbered": false, "text": "Al duro mio sopor.", "html": "Al duro mio sopor."}], [{"type": "l", "n": 65, "id": "c20.v65", "indent": 0, "missing": false, "unnumbered": false, "text": "D’ogni dolcezza vedovo,", "html": "D’ogni dolcezza vedovo,"}, {"type": "l", "n": 66, "id": "c20.v66", "indent": 0, "missing": false, "unnumbered": false, "text": "Tristo; ma non turbato,", "html": "Tristo; ma non turbato,"}, {"type": "l", "n": 67, "id": "c20.v67", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma placido il mio stato,", "html": "Ma placido il mio stato,"}, {"type": "l", "n": 68, "id": "c20.v68", "indent": 0, "missing": false, "unnumbered": false, "text": "Il volto era seren.", "html": "Il volto era seren."}], [{"type": "l", "n": 69, "id": "c20.v69", "indent": 0, "missing": false, "unnumbered": false, "text": "Desiderato il termine", "html": "Desiderato il termine"}, {"type": "l", "n": 70, "id": "c20.v70", "indent": 0, "missing": false, "unnumbered": false, "text": "Avrei del viver mio;", "html": "Avrei del viver mio;"}, {"type": "l", "n": 71, "id": "c20.v71", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma spento era il desio", "html": "Ma spento era il desio"}, {"type": "l", "n": 72, "id": "c20.v72", "indent": 0, "missing": false, "unnumbered": false, "text": "Nello spossato sen.", "html": "Nello spossato sen."}], [{"type": "l", "n": 73, "id": "c20.v73", "indent": 0, "missing": false, "unnumbered": false, "text": "Qual dell'età decrepita", "html": "Qual dell'età decrepita"}, {"type": "l", "n": 74, "id": "c20.v74", "indent": 0, "missing": false, "unnumbered": false, "text": "L’avanzo ignudo e vile,", "html": "L’avanzo ignudo e vile,"}, {"type": "l", "n": 75, "id": "c20.v75", "indent": 0, "missing": false, "unnumbered": false, "text": "Io conducea l’aprile", "html": "Io conducea l’aprile"}, {"type": "l", "n": 76, "id": "c20.v76", "indent": 0, "missing": false, "unnumbered": false, "text": "Degli anni miei così:", "html": "Degli anni miei così:"}], [{"type": "l", "n": 77, "id": "c20.v77", "indent": 0, "missing": false, "unnumbered": false, "text": "Così quegl’ineffabili", "html": "Così quegl’ineffabili"}, {"type": "l", "n": 78, "id": "c20.v78", "indent": 0, "missing": false, "unnumbered": false, "text": "Giorni, o mio cor, traevi,", "html": "Giorni, o mio cor, traevi,"}, {"type": "l", "n": 79, "id": "c20.v79", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sì fugaci e brevi", "html": "Che sì fugaci e brevi"}, {"type": "l", "n": 80, "id": "c20.v80", "indent": 0, "missing": false, "unnumbered": false, "text": "Il cielo a noi sortì.", "html": "Il cielo a noi sortì."}], [{"type": "l", "n": 81, "id": "c20.v81", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi dalla grave, immemore", "html": "Chi dalla grave, immemore"}, {"type": "l", "n": 82, "id": "c20.v82", "indent": 0, "missing": false, "unnumbered": false, "text": "Quiete or mi ridesta?", "html": "Quiete or mi ridesta?"}, {"type": "l", "n": 83, "id": "c20.v83", "indent": 0, "missing": false, "unnumbered": false, "text": "Che virtù nova è questa,", "html": "Che virtù nova è questa,"}, {"type": "l", "n": 84, "id": "c20.v84", "indent": 0, "missing": false, "unnumbered": false, "text": "Questa che sento in me?", "html": "Questa che sento in me?"}], [{"type": "l", "n": 85, "id": "c20.v85", "indent": 0, "missing": false, "unnumbered": false, "text": "Moti soavi, immagini,", "html": "Moti soavi, immagini,"}, {"type": "l", "n": 86, "id": "c20.v86", "indent": 0, "missing": false, "unnumbered": false, "text": "Palpiti, error beato,", "html": "Palpiti, error beato,"}, {"type": "l", "n": 87, "id": "c20.v87", "indent": 0, "missing": false, "unnumbered": false, "text": "Per sempre a voi negato", "html": "Per sempre a voi negato"}, {"type": "l", "n": 88, "id": "c20.v88", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo mio cor non è?", "html": "Questo mio cor non è?"}], [{"type": "l", "n": 89, "id": "c20.v89", "indent": 0, "missing": false, "unnumbered": false, "text": "Siete pur voi quell’unica", "html": "Siete pur voi quell’unica"}, {"type": "l", "n": 90, "id": "c20.v90", "indent": 0, "missing": false, "unnumbered": false, "text": "Luce de’ giorni miei?", "html": "Luce de’ giorni miei?"}, {"type": "l", "n": 91, "id": "c20.v91", "indent": 0, "missing": false, "unnumbered": false, "text": "Gli affetti ch’io perdei", "html": "Gli affetti ch’io perdei"}, {"type": "l", "n": 92, "id": "c20.v92", "indent": 0, "missing": false, "unnumbered": false, "text": "Nella novella età?", "html": "Nella novella età?"}], [{"type": "l", "n": 93, "id": "c20.v93", "indent": 0, "missing": false, "unnumbered": false, "text": "Se al ciel, s’ai verdi margini,", "html": "Se al ciel, s’ai verdi margini,"}, {"type": "l", "n": 94, "id": "c20.v94", "indent": 0, "missing": false, "unnumbered": false, "text": "Ovunque il guardo mira,", "html": "Ovunque il guardo mira,"}, {"type": "l", "n": 95, "id": "c20.v95", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutto un dolor mi spira,", "html": "Tutto un dolor mi spira,"}, {"type": "l", "n": 96, "id": "c20.v96", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutto un piacer mi dà.", "html": "Tutto un piacer mi dà."}], [{"type": "l", "n": 97, "id": "c20.v97", "indent": 0, "missing": false, "unnumbered": false, "text": "Meco ritorna a vivere", "html": "Meco ritorna a vivere"}, {"type": "l", "n": 98, "id": "c20.v98", "indent": 0, "missing": false, "unnumbered": false, "text": "La piaggia, il bosco, il monte;", "html": "La piaggia, il bosco, il monte;"}, {"type": "l", "n": 99, "id": "c20.v99", "indent": 0, "missing": false, "unnumbered": false, "text": "Parla al mio core il fonte,", "html": "Parla al mio core il fonte,"}, {"type": "l", "n": 100, "id": "c20.v100", "indent": 0, "missing": false, "unnumbered": false, "text": "Meco favella il mar.", "html": "Meco favella il mar."}], [{"type": "l", "n": 101, "id": "c20.v101", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi mi ridona il piangere,", "html": "Chi mi ridona il piangere,"}, {"type": "l", "n": 102, "id": "c20.v102", "indent": 0, "missing": false, "unnumbered": false, "text": "Dopo cotanto obblio?", "html": "Dopo cotanto obblio?"}, {"type": "l", "n": 103, "id": "c20.v103", "indent": 0, "missing": false, "unnumbered": false, "text": "E come al guardo mio", "html": "E come al guardo mio"}, {"type": "l", "n": 104, "id": "c20.v104", "indent": 0, "missing": false, "unnumbered": false, "text": "Cangiato il mondo appar?", "html": "Cangiato il mondo appar?"}], [{"type": "l", "n": 105, "id": "c20.v105", "indent": 0, "missing": false, "unnumbered": false, "text": "Forse la speme, o povero", "html": "Forse la speme, o povero"}, {"type": "l", "n": 106, "id": "c20.v106", "indent": 0, "missing": false, "unnumbered": false, "text": "Mio cor, ti volse un riso?", "html": "Mio cor, ti volse un riso?"}, {"type": "l", "n": 107, "id": "c20.v107", "indent": 0, "missing": false, "unnumbered": false, "text": "Ahi della speme il viso", "html": "Ahi della speme il viso"}, {"type": "l", "n": 108, "id": "c20.v108", "indent": 0, "missing": false, "unnumbered": false, "text": "Io non vedrò mai più.", "html": "Io non vedrò mai più."}], [{"type": "l", "n": 109, "id": "c20.v109", "indent": 0, "missing": false, "unnumbered": false, "text": "Proprii mi diede i palpiti,", "html": "Proprii mi diede i palpiti,"}, {"type": "l", "n": 110, "id": "c20.v110", "indent": 0, "missing": false, "unnumbered": false, "text": "Natura, e i dolci inganni.", "html": "Natura, e i dolci inganni."}, {"type": "l", "n": 111, "id": "c20.v111", "indent": 0, "missing": false, "unnumbered": false, "text": "Sopiro in me gli affanni", "html": "Sopiro in me gli affanni"}, {"type": "l", "n": 112, "id": "c20.v112", "indent": 0, "missing": false, "unnumbered": false, "text": "L’ingenita virtù;", "html": "L’ingenita virtù;"}], [{"type": "l", "n": 113, "id": "c20.v113", "indent": 0, "missing": false, "unnumbered": false, "text": "Non l'annullàr: non vinsela", "html": "Non l'annullàr: non vinsela"}, {"type": "l", "n": 114, "id": "c20.v114", "indent": 0, "missing": false, "unnumbered": false, "text": "Il fato e la sventura;", "html": "Il fato e la sventura;"}, {"type": "l", "n": 115, "id": "c20.v115", "indent": 0, "missing": false, "unnumbered": false, "text": "Non con la vista impura", "html": "Non con la vista impura"}, {"type": "l", "n": 116, "id": "c20.v116", "indent": 0, "missing": false, "unnumbered": false, "text": "L’infausta verità.", "html": "L’infausta verità."}], [{"type": "l", "n": 117, "id": "c20.v117", "indent": 0, "missing": false, "unnumbered": false, "text": "Dalle mie vaghe immagini", "html": "Dalle mie vaghe immagini"}, {"type": "l", "n": 118, "id": "c20.v118", "indent": 0, "missing": false, "unnumbered": false, "text": "So ben ch’ella discorda:", "html": "So ben ch’ella discorda:"}, {"type": "l", "n": 119, "id": "c20.v119", "indent": 0, "missing": false, "unnumbered": false, "text": "So che natura è sorda,", "html": "So che natura è sorda,"}, {"type": "l", "n": 120, "id": "c20.v120", "indent": 0, "missing": false, "unnumbered": false, "text": "Che miserar non sa.", "html": "Che miserar non sa."}], [{"type": "l", "n": 121, "id": "c20.v121", "indent": 0, "missing": false, "unnumbered": false, "text": "Che non del ben sollecita", "html": "Che non del ben sollecita"}, {"type": "l", "n": 122, "id": "c20.v122", "indent": 0, "missing": false, "unnumbered": false, "text": "Fu, ma dell’esser solo:", "html": "Fu, ma dell’esser solo:"}, {"type": "l", "n": 123, "id": "c20.v123", "indent": 0, "missing": false, "unnumbered": false, "text": "Purchè ci serbi al duolo,", "html": "Purchè ci serbi al duolo,"}, {"type": "l", "n": 124, "id": "c20.v124", "indent": 0, "missing": false, "unnumbered": false, "text": "Or d’altro a lei non cal.", "html": "Or d’altro a lei non cal."}], [{"type": "l", "n": 125, "id": "c20.v125", "indent": 0, "missing": false, "unnumbered": false, "text": "So che pietà fra gli uomini", "html": "So che pietà fra gli uomini"}, {"type": "l", "n": 126, "id": "c20.v126", "indent": 0, "missing": false, "unnumbered": false, "text": "Il misero non trova;", "html": "Il misero non trova;"}, {"type": "l", "n": 127, "id": "c20.v127", "indent": 0, "missing": false, "unnumbered": false, "text": "Che lui, fuggendo, a prova", "html": "Che lui, fuggendo, a prova"}, {"type": "l", "n": 128, "id": "c20.v128", "indent": 0, "missing": false, "unnumbered": false, "text": "Schernisce ogni mortal.", "html": "Schernisce ogni mortal."}], [{"type": "l", "n": 129, "id": "c20.v129", "indent": 0, "missing": false, "unnumbered": false, "text": "Che ignora il tristo secolo", "html": "Che ignora il tristo secolo"}, {"type": "l", "n": 130, "id": "c20.v130", "indent": 0, "missing": false, "unnumbered": false, "text": "Gl’ingegni e le virtudi;", "html": "Gl’ingegni e le virtudi;"}, {"type": "l", "n": 131, "id": "c20.v131", "indent": 0, "missing": false, "unnumbered": false, "text": "Che manca ai degni studi", "html": "Che manca ai degni studi"}, {"type": "l", "n": 132, "id": "c20.v132", "indent": 0, "missing": false, "unnumbered": false, "text": "L’ignuda gloria ancor.", "html": "L’ignuda gloria ancor."}], [{"type": "l", "n": 133, "id": "c20.v133", "indent": 0, "missing": false, "unnumbered": false, "text": "E voi, pupille tremule,", "html": "E voi, pupille tremule,"}, {"type": "l", "n": 134, "id": "c20.v134", "indent": 0, "missing": false, "unnumbered": false, "text": "Voi, raggio sovrumano,", "html": "Voi, raggio sovrumano,"}, {"type": "l", "n": 135, "id": "c20.v135", "indent": 0, "missing": false, "unnumbered": false, "text": "So che splendete invano,", "html": "So che splendete invano,"}, {"type": "l", "n": 136, "id": "c20.v136", "indent": 0, "missing": false, "unnumbered": false, "text": "Che in voi non brilla amor.", "html": "Che in voi non brilla amor."}], [{"type": "l", "n": 137, "id": "c20.v137", "indent": 0, "missing": false, "unnumbered": false, "text": "Nessuno ignoto ed intimo", "html": "Nessuno ignoto ed intimo"}, {"type": "l", "n": 138, "id": "c20.v138", "indent": 0, "missing": false, "unnumbered": false, "text": "Affetto in voi non brilla:", "html": "Affetto in voi non brilla:"}, {"type": "l", "n": 139, "id": "c20.v139", "indent": 0, "missing": false, "unnumbered": false, "text": "Non chiude una favilla", "html": "Non chiude una favilla"}, {"type": "l", "n": 140, "id": "c20.v140", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel bianco petto in se.", "html": "Quel bianco petto in se."}], [{"type": "l", "n": 141, "id": "c20.v141", "indent": 0, "missing": false, "unnumbered": false, "text": "Anzi d’altrui le tenere", "html": "Anzi d’altrui le tenere"}, {"type": "l", "n": 142, "id": "c20.v142", "indent": 0, "missing": false, "unnumbered": false, "text": "Cure suol porre in gioco;", "html": "Cure suol porre in gioco;"}, {"type": "l", "n": 143, "id": "c20.v143", "indent": 0, "missing": false, "unnumbered": false, "text": "E d’un celeste foco", "html": "E d’un celeste foco"}, {"type": "l", "n": 144, "id": "c20.v144", "indent": 0, "missing": false, "unnumbered": false, "text": "Disprezzo è la mercè.", "html": "Disprezzo è la mercè."}], [{"type": "l", "n": 145, "id": "c20.v145", "indent": 0, "missing": false, "unnumbered": false, "text": "Pur sento in me rivivere", "html": "Pur sento in me rivivere"}, {"type": "l", "n": 146, "id": "c20.v146", "indent": 0, "missing": false, "unnumbered": false, "text": "Gl’inganni aperti e noti;", "html": "Gl’inganni aperti e noti;"}, {"type": "l", "n": 147, "id": "c20.v147", "indent": 0, "missing": false, "unnumbered": false, "text": "E de’ suoi proprii moti", "html": "E de’ suoi proprii moti"}, {"type": "l", "n": 148, "id": "c20.v148", "indent": 0, "missing": false, "unnumbered": false, "text": "Si maraviglia il sen.", "html": "Si maraviglia il sen."}], [{"type": "l", "n": 149, "id": "c20.v149", "indent": 0, "missing": false, "unnumbered": false, "text": "Da te, mio cor, quest’ultimo", "html": "Da te, mio cor, quest’ultimo"}, {"type": "l", "n": 150, "id": "c20.v150", "indent": 0, "missing": false, "unnumbered": false, "text": "Spirto, e l’ardor natio,", "html": "Spirto, e l’ardor natio,"}, {"type": "l", "n": 151, "id": "c20.v151", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni conforto mio", "html": "Ogni conforto mio"}, {"type": "l", "n": 152, "id": "c20.v152", "indent": 0, "missing": false, "unnumbered": false, "text": "Solo da te mi vien.", "html": "Solo da te mi vien."}], [{"type": "l", "n": 153, "id": "c20.v153", "indent": 0, "missing": false, "unnumbered": false, "text": "Mancano, il sento, all'anima", "html": "Mancano, il sento, all'anima"}, {"type": "l", "n": 154, "id": "c20.v154", "indent": 0, "missing": false, "unnumbered": false, "text": "Alta, gentile e pura,", "html": "Alta, gentile e pura,"}, {"type": "l", "n": 155, "id": "c20.v155", "indent": 0, "missing": false, "unnumbered": false, "text": "La sorte, la natura,", "html": "La sorte, la natura,"}, {"type": "l", "n": 156, "id": "c20.v156", "indent": 0, "missing": false, "unnumbered": false, "text": "Il mondo e la beltà.", "html": "Il mondo e la beltà."}], [{"type": "l", "n": 157, "id": "c20.v157", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma se tu vivi, o misero,", "html": "Ma se tu vivi, o misero,"}, {"type": "l", "n": 158, "id": "c20.v158", "indent": 0, "missing": false, "unnumbered": false, "text": "Se non concedi al fato,", "html": "Se non concedi al fato,"}, {"type": "l", "n": 159, "id": "c20.v159", "indent": 0, "missing": false, "unnumbered": false, "text": "Non chiamerò spietato", "html": "Non chiamerò spietato"}, {"type": "l", "n": 160, "id": "c20.v160", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi lo spirar mi dà.", "html": "Chi lo spirar mi dà."}]]}
