{"n": 41, "roman": "XLI", "title": "Dello stesso", "slug": "dello-stesso", "incipit": "Umana cosa picciol tempo dura,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XLI._Dello_stesso_p._169", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XLI._Dello_stesso_p._170"]}, "head": ["XLI.", "DELLO STESSO."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c41.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Umana cosa picciol tempo dura,", "html": "Umana cosa picciol tempo dura,"}, {"type": "l", "n": 2, "id": "c41.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "E certissimo detto", "html": "E certissimo detto"}, {"type": "l", "n": 3, "id": "c41.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Disse il veglio di Chio,", "html": "Disse il veglio di Chio,"}, {"type": "l", "n": 4, "id": "c41.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Conforme ebber natura", "html": "Conforme ebber natura"}, {"type": "l", "n": 5, "id": "c41.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Le foglie e l’uman seme.", "html": "Le foglie e l’uman seme."}, {"type": "l", "n": 6, "id": "c41.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma questa voce in petto", "html": "Ma questa voce in petto"}, {"type": "l", "n": 7, "id": "c41.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Raccolgon pochi. All’inquieta speme,", "html": "Raccolgon pochi. All’inquieta speme,"}, {"type": "l", "n": 8, "id": "c41.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Figlia di giovin core,", "html": "Figlia di giovin core,"}, {"type": "l", "n": 9, "id": "c41.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Tutti prestiam ricetto.", "html": "Tutti prestiam ricetto."}, {"type": "l", "n": 10, "id": "c41.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Mentre è vermiglio il fiore", "html": "Mentre è vermiglio il fiore"}, {"type": "l", "n": 11, "id": "c41.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Di nostra etade acerba,", "html": "Di nostra etade acerba,"}, {"type": "l", "n": 12, "id": "c41.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "L’alma vota e superba", "html": "L’alma vota e superba"}, {"type": "l", "n": 13, "id": "c41.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Cento dolci pensieri educa invano,", "html": "Cento dolci pensieri educa invano,"}, {"type": "l", "n": 14, "id": "c41.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Nè morte aspetta nè vecchiezza; e nulla", "html": "Nè morte aspetta nè vecchiezza; e nulla"}, {"type": "l", "n": 15, "id": "c41.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Cura di morbi ha l’uom gagliardo e sano.", "html": "Cura di morbi ha l’uom gagliardo e sano."}, {"type": "l", "n": 16, "id": "c41.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma stolto è chi non vede", "html": "Ma stolto è chi non vede"}, {"type": "l", "n": 17, "id": "c41.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "La giovanezza come ha ratte l’ale,", "html": "La giovanezza come ha ratte l’ale,"}, {"type": "l", "n": 18, "id": "c41.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "E siccome alla culla", "html": "E siccome alla culla"}, {"type": "l", "n": 19, "id": "c41.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Poco il rogo è lontano.", "html": "Poco il rogo è lontano."}, {"type": "l", "n": 20, "id": "c41.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu presso a porre il piede", "html": "Tu presso a porre il piede"}, {"type": "l", "n": 21, "id": "c41.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "In sul varco fatale", "html": "In sul varco fatale"}, {"type": "l", "n": 22, "id": "c41.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Della plutonia sede,", "html": "Della plutonia sede,"}, {"type": "l", "n": 23, "id": "c41.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Ai presenti diletti", "html": "Ai presenti diletti"}, {"type": "l", "n": 24, "id": "c41.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "La breve età commetti.", "html": "La breve età commetti."}]]}
