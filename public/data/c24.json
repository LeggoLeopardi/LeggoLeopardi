{"n": 24, "roman": "XXIV", "title": "La quiete dopo la tempesta", "slug": "la-quiete-dopo-la-tempesta", "incipit": "Passata è la tempesta:", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIV._La_quiete_dopo_la_tempesta_p._114", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIV._La_quiete_dopo_la_tempesta_p._115", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIV._La_quiete_dopo_la_tempesta_p._116"]}, "head": ["XXIV.", "LA QUIETE", "DOPO LA TEMPESTA."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c24.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Passata è la tempesta:", "html": "Passata è la tempesta:"}, {"type": "l", "n": 2, "id": "c24.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Odo augelli far festa, e la gallina,", "html": "Odo augelli far festa, e la gallina,"}, {"type": "l", "n": 3, "id": "c24.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Tornata in su la via,", "html": "Tornata in su la via,"}, {"type": "l", "n": 4, "id": "c24.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Che ripete il suo verso. Ecco il sereno", "html": "Che ripete il suo verso. Ecco il sereno"}, {"type": "l", "n": 5, "id": "c24.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Rompe là da ponente, alla montagna;", "html": "Rompe là da ponente, alla montagna;"}, {"type": "l", "n": 6, "id": "c24.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Sgombrasi la campagna,", "html": "Sgombrasi la campagna,"}, {"type": "l", "n": 7, "id": "c24.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "E chiaro nella valle il fiume appare.", "html": "E chiaro nella valle il fiume appare."}, {"type": "l", "n": 8, "id": "c24.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni cor si rallegra, in ogni lato", "html": "Ogni cor si rallegra, in ogni lato"}, {"type": "l", "n": 9, "id": "c24.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Risorge il romorio", "html": "Risorge il romorio"}, {"type": "l", "n": 10, "id": "c24.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Torna il lavoro usato.", "html": "Torna il lavoro usato."}, {"type": "l", "n": 11, "id": "c24.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "L’artigiano a mirar l’umido cielo,", "html": "L’artigiano a mirar l’umido cielo,"}, {"type": "l", "n": 12, "id": "c24.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Con l’opra in man, cantando,", "html": "Con l’opra in man, cantando,"}, {"type": "l", "n": 13, "id": "c24.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Fassi in su l’uscio; a prova", "html": "Fassi in su l’uscio; a prova"}, {"type": "l", "n": 14, "id": "c24.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Vien fuor la femminetta a còr dell’acqua", "html": "Vien fuor la femminetta a còr dell’acqua"}, {"type": "l", "n": 15, "id": "c24.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Della novella piova;", "html": "Della novella piova;"}, {"type": "l", "n": 16, "id": "c24.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "E l’erbaiuol rinnova", "html": "E l’erbaiuol rinnova"}, {"type": "l", "n": 17, "id": "c24.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Di sentiero in sentiero", "html": "Di sentiero in sentiero"}, {"type": "l", "n": 18, "id": "c24.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Il grido giornaliero.", "html": "Il grido giornaliero."}, {"type": "l", "n": 19, "id": "c24.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Ecco il Sol che ritorna, ecco sorride", "html": "Ecco il Sol che ritorna, ecco sorride"}, {"type": "l", "n": 20, "id": "c24.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Per li poggi e le ville. Apre i balconi,", "html": "Per li poggi e le ville. Apre i balconi,"}, {"type": "l", "n": 21, "id": "c24.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Apre terrazzi e logge la famiglia:", "html": "Apre terrazzi e logge la famiglia:"}, {"type": "l", "n": 22, "id": "c24.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "E, dalla via corrente, odi lontano", "html": "E, dalla via corrente, odi lontano"}, {"type": "l", "n": 23, "id": "c24.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Tintinnio di sonagli; il carro stride", "html": "Tintinnio di sonagli; il carro stride"}, {"type": "l", "n": 24, "id": "c24.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Del passegger che il suo cammin ripiglia.", "html": "Del passegger che il suo cammin ripiglia."}], [{"type": "l", "n": 25, "id": "c24.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Si rallegra ogni core.", "html": "Si rallegra ogni core."}, {"type": "l", "n": 26, "id": "c24.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Sì dolce, sì gradita", "html": "Sì dolce, sì gradita"}, {"type": "l", "n": 27, "id": "c24.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Quand’è, com’or, la vita?", "html": "Quand’è, com’or, la vita?"}, {"type": "l", "n": 28, "id": "c24.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando con tanto amore", "html": "Quando con tanto amore"}, {"type": "l", "n": 29, "id": "c24.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "L’uomo a’ suoi studi intende?", "html": "L’uomo a’ suoi studi intende?"}, {"type": "l", "n": 30, "id": "c24.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "O torna all’opre? o cosa nova imprende?", "html": "O torna all’opre? o cosa nova imprende?"}, {"type": "l", "n": 31, "id": "c24.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando de’ mali suoi men si ricorda?", "html": "Quando de’ mali suoi men si ricorda?"}, {"type": "l", "n": 32, "id": "c24.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Piacer figlio d’affanno;", "html": "Piacer figlio d’affanno;"}, {"type": "l", "n": 33, "id": "c24.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Gioia vana, ch’è frutto", "html": "Gioia vana, ch’è frutto"}, {"type": "l", "n": 34, "id": "c24.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Del passato timore, onde si scosse", "html": "Del passato timore, onde si scosse"}, {"type": "l", "n": 35, "id": "c24.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "E paventò la morte", "html": "E paventò la morte"}, {"type": "l", "n": 36, "id": "c24.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi la vita abborria;", "html": "Chi la vita abborria;"}, {"type": "l", "n": 37, "id": "c24.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Onde in lungo tormento,", "html": "Onde in lungo tormento,"}, {"type": "l", "n": 38, "id": "c24.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Fredde, tacite, smorte,", "html": "Fredde, tacite, smorte,"}, {"type": "l", "n": 39, "id": "c24.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Sudàr le genti e palpitàr, vedendo", "html": "Sudàr le genti e palpitàr, vedendo"}, {"type": "l", "n": 40, "id": "c24.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Mossi alle nostre offese", "html": "Mossi alle nostre offese"}, {"type": "l", "n": 41, "id": "c24.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Folgori, nembi e vento.", "html": "Folgori, nembi e vento."}], [{"type": "l", "n": 42, "id": "c24.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "O natura cortese,", "html": "O natura cortese,"}, {"type": "l", "n": 43, "id": "c24.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Son questi i doni tuoi,", "html": "Son questi i doni tuoi,"}, {"type": "l", "n": 44, "id": "c24.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Questi i diletti sono", "html": "Questi i diletti sono"}, {"type": "l", "n": 45, "id": "c24.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tu porgi ai mortali. Uscir di pena", "html": "Che tu porgi ai mortali. Uscir di pena"}, {"type": "l", "n": 46, "id": "c24.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "È diletto fra noi.", "html": "È diletto fra noi."}, {"type": "l", "n": 47, "id": "c24.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Pene tu spargi a larga mano; il duolo", "html": "Pene tu spargi a larga mano; il duolo"}, {"type": "l", "n": 48, "id": "c24.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Spontaneo sorge: e di piacer, quel tanto", "html": "Spontaneo sorge: e di piacer, quel tanto"}, {"type": "l", "n": 49, "id": "c24.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Che per mostro e miracolo talvolta", "html": "Che per mostro e miracolo talvolta"}, {"type": "l", "n": 50, "id": "c24.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Nasce d’affanno, è gran guadagno. Umana", "html": "Nasce d’affanno, è gran guadagno. Umana"}, {"type": "l", "n": 51, "id": "c24.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Prole cara agli eterni! assai felice", "html": "Prole cara agli eterni! assai felice"}, {"type": "l", "n": 52, "id": "c24.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Se respirar ti lice", "html": "Se respirar ti lice"}, {"type": "l", "n": 53, "id": "c24.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "D’alcun dolor: beata", "html": "D’alcun dolor: beata"}, {"type": "l", "n": 54, "id": "c24.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Se te d’ogni dolor morte risana.", "html": "Se te d’ogni dolor morte risana."}]]}
