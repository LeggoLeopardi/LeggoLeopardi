{"n": 25, "roman": "XXV", "title": "Il sabato del villaggio", "slug": "il-sabato-del-villaggio", "incipit": "La donzelletta vien dalla campagna,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXV._%C7%81_IL_SABATO_%C7%81_DEL_VILLAGGIO._p._117", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXV._%C7%81_IL_SABATO_%C7%81_DEL_VILLAGGIO._p._118", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXV._%C7%81_IL_SABATO_%C7%81_DEL_VILLAGGIO._p._119"]}, "head": ["XXV.", "IL SABATO DEL VILLAGGIO."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c25.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "La donzelletta vien dalla campagna,", "html": "La donzelletta vien dalla campagna,"}, {"type": "l", "n": 2, "id": "c25.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "In sul calar del sole,", "html": "In sul calar del sole,"}, {"type": "l", "n": 3, "id": "c25.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Col suo fascio dell'erba; e reca in mano", "html": "Col suo fascio dell'erba; e reca in mano"}, {"type": "l", "n": 4, "id": "c25.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Un mazzolin di rose e di viole,", "html": "Un mazzolin di rose e di viole,"}, {"type": "l", "n": 5, "id": "c25.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Onde, siccome suole,", "html": "Onde, siccome suole,"}, {"type": "l", "n": 6, "id": "c25.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Ornare ella si appresta", "html": "Ornare ella si appresta"}, {"type": "l", "n": 7, "id": "c25.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Dimani, al dì di festa, il petto e il crine.", "html": "Dimani, al dì di festa, il petto e il crine."}, {"type": "l", "n": 8, "id": "c25.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Siede con le vicine", "html": "Siede con le vicine"}, {"type": "l", "n": 9, "id": "c25.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Su la scala a filar la vecchierella,", "html": "Su la scala a filar la vecchierella,"}, {"type": "l", "n": 10, "id": "c25.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Incontro là dove si perde il giorno;", "html": "Incontro là dove si perde il giorno;"}, {"type": "l", "n": 11, "id": "c25.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "E novellando vien del suo buon tempo,", "html": "E novellando vien del suo buon tempo,"}, {"type": "l", "n": 12, "id": "c25.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando ai dì della festa ella si ornava,", "html": "Quando ai dì della festa ella si ornava,"}, {"type": "l", "n": 13, "id": "c25.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed ancor sana e snella", "html": "Ed ancor sana e snella"}, {"type": "l", "n": 14, "id": "c25.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Solea danzar la sera intra di quei", "html": "Solea danzar la sera intra di quei"}, {"type": "l", "n": 15, "id": "c25.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’ebbe compagni dell'età più bella.", "html": "Ch’ebbe compagni dell'età più bella."}, {"type": "l", "n": 16, "id": "c25.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Già tutta l’aria imbruna,", "html": "Già tutta l’aria imbruna,"}, {"type": "l", "n": 17, "id": "c25.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Torna azzurro il sereno, e tornan l’ombre", "html": "Torna azzurro il sereno, e tornan l’ombre"}, {"type": "l", "n": 18, "id": "c25.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Giù da' colli e da' tetti,", "html": "Giù da' colli e da' tetti,"}, {"type": "l", "n": 19, "id": "c25.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Al biancheggiar della recente luna.", "html": "Al biancheggiar della recente luna."}, {"type": "l", "n": 20, "id": "c25.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Or la squilla dà segno", "html": "Or la squilla dà segno"}, {"type": "l", "n": 21, "id": "c25.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Della festa che viene;", "html": "Della festa che viene;"}, {"type": "l", "n": 22, "id": "c25.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed a quel suon diresti", "html": "Ed a quel suon diresti"}, {"type": "l", "n": 23, "id": "c25.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Che il cor si riconforta.", "html": "Che il cor si riconforta."}, {"type": "l", "n": 24, "id": "c25.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "I fanciulli gridando", "html": "I fanciulli gridando"}, {"type": "l", "n": 25, "id": "c25.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Su la piazzuola in frotta,", "html": "Su la piazzuola in frotta,"}, {"type": "l", "n": 26, "id": "c25.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "E qua e là saltando,", "html": "E qua e là saltando,"}, {"type": "l", "n": 27, "id": "c25.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Fanno un lieto romore:", "html": "Fanno un lieto romore:"}, {"type": "l", "n": 28, "id": "c25.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "E intanto riede alla sua parca mensa,", "html": "E intanto riede alla sua parca mensa,"}, {"type": "l", "n": 29, "id": "c25.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Fischiando, il zappatore,", "html": "Fischiando, il zappatore,"}, {"type": "l", "n": 30, "id": "c25.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "E seco pensa al dì del suo riposo.", "html": "E seco pensa al dì del suo riposo."}], [{"type": "l", "n": 31, "id": "c25.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Poi quando intorno è spenta ogni altra face,", "html": "Poi quando intorno è spenta ogni altra face,"}, {"type": "l", "n": 32, "id": "c25.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "E tutto l'altro tace,", "html": "E tutto l'altro tace,"}, {"type": "l", "n": 33, "id": "c25.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Odi il martel picchiare, odi la sega", "html": "Odi il martel picchiare, odi la sega"}, {"type": "l", "n": 34, "id": "c25.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Del legnaiuol, che veglia", "html": "Del legnaiuol, che veglia"}, {"type": "l", "n": 35, "id": "c25.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Nella chiusa bottega alla lucerna,", "html": "Nella chiusa bottega alla lucerna,"}, {"type": "l", "n": 36, "id": "c25.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "E s'affretta, e s'adopra", "html": "E s'affretta, e s'adopra"}, {"type": "l", "n": 37, "id": "c25.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Di fornir l'opra anzi il chiarir dell'alba.", "html": "Di fornir l'opra anzi il chiarir dell'alba."}], [{"type": "l", "n": 38, "id": "c25.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo di sette è il più gradito giorno,", "html": "Questo di sette è il più gradito giorno,"}, {"type": "l", "n": 39, "id": "c25.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Pien di speme e di gioia:", "html": "Pien di speme e di gioia:"}, {"type": "l", "n": 40, "id": "c25.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Diman tristezza e noia", "html": "Diman tristezza e noia"}, {"type": "l", "n": 41, "id": "c25.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Recheran l'ore, ed al travaglio usato", "html": "Recheran l'ore, ed al travaglio usato"}, {"type": "l", "n": 42, "id": "c25.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Ciascuno in suo pensier farà ritorno.", "html": "Ciascuno in suo pensier farà ritorno."}, {"type": "l", "n": 43, "id": "c25.v43", "indent": 1, "missing": false, "unnumbered": false, "text": "Garzoncello scherzoso,", "html": "Garzoncello scherzoso,"}, {"type": "l", "n": 44, "id": "c25.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Cotesta età fiorita", "html": "Cotesta età fiorita"}, {"type": "l", "n": 45, "id": "c25.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "È come un giorno d'allegrezza pieno,", "html": "È come un giorno d'allegrezza pieno,"}, {"type": "l", "n": 46, "id": "c25.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Giorno chiaro, sereno,", "html": "Giorno chiaro, sereno,"}, {"type": "l", "n": 47, "id": "c25.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Che precorre alla festa di tua vita.", "html": "Che precorre alla festa di tua vita."}, {"type": "l", "n": 48, "id": "c25.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Godi, fanciullo mio; stato soave,", "html": "Godi, fanciullo mio; stato soave,"}, {"type": "l", "n": 49, "id": "c25.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Stagion lieta è cotesta.", "html": "Stagion lieta è cotesta."}, {"type": "l", "n": 50, "id": "c25.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Altro dirti non vo'; ma la tua festa", "html": "Altro dirti non vo'; ma la tua festa"}, {"type": "l", "n": 51, "id": "c25.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch'anco tardi a venir non ti sia grave.", "html": "Ch'anco tardi a venir non ti sia grave."}]]}
