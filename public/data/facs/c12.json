{"n": 12, "roman": "XII", "title": "L'infinito", "slug": "l-infinito", "credits": ["Roberta Priore", "Beatrice Nava"], "layers": {"layer0": "Penna A 1819", "layer1": "Penna B 1820", "layer2": "Penna C 1821", "layer3": "Penna D 1825"}, "witnesses": [{"siglum": "AN", "label": "Napoli Biblioteca Nazionale «Vittorio Emanuele III» C.L. XIII.22", "image": null, "zones": null, "head": ["<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">Idillio</a>", "<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">L'Infinito</a>"], "verses": [{"n": 1, "html": "Sempre caro mi fu quest’ermo <a class=\"place\" href=\"#place-p2\" data-place=\"p2\">colle,</a>"}, {"n": 2, "html": "E questa <a class=\"place\" href=\"#place-p3\" data-place=\"p3\">siepe,</a> che da tanta parte"}, {"n": 3, "html": "<a class=\"place\" href=\"#place-p4\" data-place=\"p4\">De l'ultimo orizzonte</a> il guardo esclude."}, {"n": 4, "html": "Ma sedendo e <a class=\"place\" href=\"#place-p5\" data-place=\"p5\">mirando,</a> <a class=\"place\" href=\"#place-p6\" data-place=\"p6\">interminato</a>"}, {"n": 5, "html": "<a class=\"place\" href=\"#place-p6\" data-place=\"p6\">spazio</a> di là da quella, e sovrumani"}, {"n": 6, "html": "Silenzi, e profondissima quiete"}, {"n": 7, "html": "Io <a class=\"place\" href=\"#place-p7\" data-place=\"p7\">nel pensier mi</a> <a class=\"place\" href=\"#place-p8\" data-place=\"p8\">fingo,</a> ove per poco"}, {"n": 8, "html": "Il cor non si spaura. E come il vento"}, {"n": 9, "html": "Odo stormir <a class=\"place\" href=\"#place-p9\" data-place=\"p9\">tra</a> queste piante, io quello"}, {"n": 10, "html": "Infinito silenzio a questa voce"}, {"n": 11, "html": "Vo <a class=\"place\" href=\"#place-p10\" data-place=\"p10\">comparando: e</a> mi sovvien l’eterno,"}, {"n": 12, "html": "E le morte stagioni, e la presente"}, {"n": 13, "html": "E viva, <a class=\"place\" href=\"#place-p11\" data-place=\"p11\">e 'l</a> suon di lei. Così <a class=\"place\" href=\"#place-p12\" data-place=\"p12\">tra</a> questa"}, {"n": 14, "html": "<a class=\"place\" href=\"#place-p13\" data-place=\"p13\">Infinità s'annega il pensier mio:</a>"}, {"n": 15, "html": "E <a class=\"place\" href=\"#place-p14\" data-place=\"p14\">'l</a> naufragar m’è dolce in questo mare."}]}, {"siglum": "AV", "label": "Visso Archivio comunale di Visso", "image": null, "zones": null, "head": ["<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">Idilli</a>", "<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">MDCCCXIX V L'Infinito</a>", "<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">Idillio I</a>"], "verses": [{"n": 1, "html": "Sempre caro mi fu quest’ermo <a class=\"place\" href=\"#place-p2\" data-place=\"p2\">colle,</a>"}, {"n": 2, "html": "E questa <a class=\"place\" href=\"#place-p3\" data-place=\"p3\">siepe,</a> che da tanta parte"}, {"n": 3, "html": "<a class=\"place\" href=\"#place-p4\" data-place=\"p4\">De l'ultimo orizzonte</a> il guardo esclude."}, {"n": 4, "html": "Ma sedendo e <a class=\"place\" href=\"#place-p5\" data-place=\"p5\">mirando,</a> <a class=\"place\" href=\"#place-p6\" data-place=\"p6\">interminato</a>"}, {"n": 5, "html": "<a class=\"place\" href=\"#place-p6\" data-place=\"p6\">spazio</a> di là da quella, e sovrumani"}, {"n": 6, "html": "Silenzi, e profondissima quiete"}, {"n": 7, "html": "Io <a class=\"place\" href=\"#place-p7\" data-place=\"p7\">nel pensier mi</a> <a class=\"place\" href=\"#place-p8\" data-place=\"p8\">fingo,</a> ove per poco"}, {"n": 8, "html": "Il cor non si spaura. E come il vento"}, {"n": 9, "html": "Odo stormir <a class=\"place\" href=\"#place-p9\" data-place=\"p9\">tra</a> queste piante, io quello"}, {"n": 10, "html": "Infinito silenzio a questa voce"}, {"n": 11, "html": "Vo <a class=\"place\" href=\"#place-p10\" data-place=\"p10\">comparando: e</a> mi sovvien l’eterno,"}, {"n": 12, "html": "E le morte stagioni, e la presente"}, {"n": 13, "html": "E viva, <a class=\"place\" href=\"#place-p11\" data-place=\"p11\">e 'l</a> suon di lei. Così <a class=\"place\" href=\"#place-p12\" data-place=\"p12\">tra</a> questa"}, {"n": 14, "html": "<a class=\"place\" href=\"#place-p13\" data-place=\"p13\">Infinità s'annega il pensier mio:</a>"}, {"n": 15, "html": "E <a class=\"place\" href=\"#place-p14\" data-place=\"p14\">'l</a> naufragar m’è dolce in questo mare."}]}, {"siglum": "NR25", "label": "Nuovo ricoglitore 1825", "image": "/img/facs/c12-NR25.jpg", "zones": {"1": [19.5, 33.39, 38.67, 1.66], "2": [19.17, 35.04, 43.33, 1.6], "3": [22.0, 36.64, 47.0, 1.66], "4": [22.0, 38.3, 36.92, 1.66], "5": [22.08, 39.96, 40.67, 1.66], "6": [22.0, 41.61, 44.0, 1.66], "7": [22.0, 43.27, 47.42, 1.66], "8": [22.08, 44.92, 45.92, 1.66], "9": [22.42, 46.58, 41.75, 1.66], "10": [22.33, 48.23, 39.0, 1.6], "11": [22.17, 49.83, 46.83, 1.66], "12": [22.17, 51.49, 49.5, 1.66], "13": [22.17, 53.15, 44.58, 1.66], "14": [19.92, 54.8, 36.08, 1.6], "15": [22.08, 56.4, 42.25, 1.1]}, "head": ["<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">L'INFINITO.</a>", "<a class=\"place\" href=\"#place-p1\" data-place=\"p1\">Idillio I.</a>"], "verses": [{"n": 1, "html": "Sempre caro mi fu quest’ermo <a class=\"place\" href=\"#place-p2\" data-place=\"p2\">colle,</a>"}, {"n": 2, "html": "E questa <a class=\"place\" href=\"#place-p3\" data-place=\"p3\">siepe,</a> che da tanta parte"}, {"n": 3, "html": "<a class=\"place\" href=\"#place-p4\" data-place=\"p4\">De l'ultimo orizzonte</a> il guardo esclude."}, {"n": 4, "html": "Ma sedendo e <a class=\"place\" href=\"#place-p5\" data-place=\"p5\">mirando,</a> <a class=\"place\" href=\"#place-p6\" data-place=\"p6\">interminato</a>"}, {"n": 5, "html": "<a class=\"place\" href=\"#place-p6\" data-place=\"p6\">spazio</a> di là da quella, e sovrumani"}, {"n": 6, "html": "Silenzi, e profondissima quiete"}, {"n": 7, "html": "Io <a class=\"place\" href=\"#place-p7\" data-place=\"p7\">nel pensier mi</a> <a class=\"place\" href=\"#place-p8\" data-place=\"p8\">fingo,</a> ove per poco"}, {"n": 8, "html": "I