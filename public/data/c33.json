{"n": 33, "roman": "XXXIII", "title": "Il tramonto della luna", "slug": "il-tramonto-della-luna", "incipit": "Quale in notte solinga,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXIII._Il_tramonto_della_luna_p._1", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXIII._Il_tramonto_della_luna_p._2", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXIII._Il_tramonto_della_luna_p._3", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXIII._Il_tramonto_della_luna_p._4", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXIII._Il_tramonto_della_luna_p.5"]}, "head": ["XXXIII.", "Il tramonto della luna."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c33.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Quale in notte solinga,", "html": "Quale in notte solinga,"}, {"type": "l", "n": 2, "id": "c33.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Sovra campagne inargentate ed acque,", "html": "Sovra campagne inargentate ed acque,"}, {"type": "l", "n": 3, "id": "c33.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Là ’ve zefiro aleggia,", "html": "Là ’ve zefiro aleggia,"}, {"type": "l", "n": 4, "id": "c33.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "E mille vaghi aspetti", "html": "E mille vaghi aspetti"}, {"type": "l", "n": 5, "id": "c33.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "E ingannevoli obbietti", "html": "E ingannevoli obbietti"}, {"type": "l", "n": 6, "id": "c33.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Fingon l’ombre lontane", "html": "Fingon l’ombre lontane"}, {"type": "l", "n": 7, "id": "c33.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Infra l’onde tranquille", "html": "Infra l’onde tranquille"}, {"type": "l", "n": 8, "id": "c33.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "E rami e siepi e collinette e ville;", "html": "E rami e siepi e collinette e ville;"}, {"type": "l", "n": 9, "id": "c33.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Giunta al confin del cielo,", "html": "Giunta al confin del cielo,"}, {"type": "l", "n": 10, "id": "c33.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Dietro Apennino od Alpe, o del Tirreno", "html": "Dietro Apennino od Alpe, o del Tirreno"}, {"type": "l", "n": 11, "id": "c33.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Nell’infinito seno", "html": "Nell’infinito seno"}, {"type": "l", "n": 12, "id": "c33.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Scende la luna; e si scolora il mondo;", "html": "Scende la luna; e si scolora il mondo;"}, {"type": "l", "n": 13, "id": "c33.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Spariscon l’ombre, ed una", "html": "Spariscon l’ombre, ed una"}, {"type": "l", "n": 14, "id": "c33.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Oscurità la valle e il monte imbruna;", "html": "Oscurità la valle e il monte imbruna;"}, {"type": "l", "n": 15, "id": "c33.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Orba la notte resta,", "html": "Orba la notte resta,"}, {"type": "l", "n": 16, "id": "c33.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "E cantando, con mesta melodia,", "html": "E cantando, con mesta melodia,"}, {"type": "l", "n": 17, "id": "c33.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "L’estremo albor della fuggente luce,", "html": "L’estremo albor della fuggente luce,"}, {"type": "l", "n": 18, "id": "c33.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Che dianzi gli fu duce,", "html": "Che dianzi gli fu duce,"}, {"type": "l", "n": 19, "id": "c33.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Saluta il carrettier dalla sua via;", "html": "Saluta il carrettier dalla sua via;"}], [{"type": "l", "n": 20, "id": "c33.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Tal si dilegua, e tale", "html": "Tal si dilegua, e tale"}, {"type": "l", "n": 21, "id": "c33.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Lascia l’età mortale", "html": "Lascia l’età mortale"}, {"type": "l", "n": 22, "id": "c33.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "La giovinezza. In fuga", "html": "La giovinezza. In fuga"}, {"type": "l", "n": 23, "id": "c33.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Van l’ombre e le sembianze", "html": "Van l’ombre e le sembianze"}, {"type": "l", "n": 24, "id": "c33.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Dei dilettosi inganni; e vengon meno", "html": "Dei dilettosi inganni; e vengon meno"}, {"type": "l", "n": 25, "id": "c33.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Le lontane speranze,", "html": "Le lontane speranze,"}, {"type": "l", "n": 26, "id": "c33.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Ove s’appoggia la mortal natura.", "html": "Ove s’appoggia la mortal natura."}, {"type": "l", "n": 27, "id": "c33.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Abbandonata, oscura", "html": "Abbandonata, oscura"}, {"type": "l", "n": 28, "id": "c33.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Resta la vita. In lei porgendo il guardo,", "html": "Resta la vita. In lei porgendo il guardo,"}, {"type": "l", "n": 29, "id": "c33.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Cerca il confuso viatore invano", "html": "Cerca il confuso viatore invano"}, {"type": "l", "n": 30, "id": "c33.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Del cammin lungo che avanzar si sente", "html": "Del cammin lungo che avanzar si sente"}, {"type": "l", "n": 31, "id": "c33.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Meta o ragione; e vede", "html": "Meta o ragione; e vede"}, {"type": "l", "n": 32, "id": "c33.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Che a se l’umana sede,", "html": "Che a se l’umana sede,"}, {"type": "l", "n": 33, "id": "c33.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Esso a lei veramente è fatto estrano.", "html": "Esso a lei veramente è fatto estrano."}], [{"type": "l", "n": 34, "id": "c33.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Troppo felice e lieta", "html": "Troppo felice e lieta"}, {"type": "l", "n": 35, "id": "c33.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Nostra misera sorte", "html": "Nostra misera sorte"}, {"type": "l", "n": 36, "id": "c33.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "Parve lassù, se il giovanile stato,", "html": "Parve lassù, se il giovanile stato,"}, {"type": "l", "n": 37, "id": "c33.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Dove ogni ben di mille pene è frutto,", "html": "Dove ogni ben di mille pene è frutto,"}, {"type": "l", "n": 38, "id": "c33.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Durasse tutto della vita il corso.", "html": "Durasse tutto della vita il corso."}, {"type": "l", "n": 39, "id": "c33.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Troppo mite decreto", "html": "Troppo mite decreto"}, {"type": "l", "n": 40, "id": "c33.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel che sentenzia ogni animale a morte,", "html": "Quel che sentenzia ogni animale a morte,"}, {"type": "l", "n": 41, "id": "c33.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "S’anco mezza la via", "html": "S’anco mezza la via"}, {"type": "l", "n": 42, "id": "c33.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Lor non si desse in pria", "html": "Lor non si desse in pria"}, {"type": "l", "n": 43, "id": "c33.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Della terribil morte assai più dura.", "html": "Della terribil morte assai più dura."}, {"type": "l", "n": 44, "id": "c33.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "D’intelletti immortali", "html": "D’intelletti immortali"}, {"type": "l", "n": 45, "id": "c33.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Degno trovato, estremo", "html": "Degno trovato, estremo"}, {"type": "l", "n": 46, "id": "c33.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Di tutti i mali, ritrovàr gli eterni", "html": "Di tutti i mali, ritrovàr gli eterni"}, {"type": "l", "n": 47, "id": "c33.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "La vecchiezza, ove fosse", "html": "La vecchiezza, ove fosse"}, {"type": "l", "n": 48, "id": "c33.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Incolume il desio, la speme estinta,", "html": "Incolume il desio, la speme estinta,"}, {"type": "l", "n": 49, "id": "c33.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Secche le fonti del piacer, le pene", "html": "Secche le fonti del piacer, le pene"}, {"type": "l", "n": 50, "id": "c33.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Maggiori sempre, e non più dato il bene.", "html": "Maggiori sempre, e non più dato il bene."}], [{"type": "l", "n": 51, "id": "c33.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Voi, collinette e piagge,", "html": "Voi, collinette e piagge,"}, {"type": "l", "n": 52, "id": "c33.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Caduto lo splendor che all’occidente", "html": "Caduto lo splendor che all’occidente"}, {"type": "l", "n": 53, "id": "c33.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Inargentava della notte il velo,", "html": "Inargentava della notte il velo,"}, {"type": "l", "n": 54, "id": "c33.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Orfane ancor gran tempo", "html": "Orfane ancor gran tempo"}, {"type": "l", "n": 55, "id": "c33.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Non resterete; che dall’altra parte", "html": "Non resterete; che dall’altra parte"}, {"type": "l", "n": 56, "id": "c33.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Tosto vedrete il cielo", "html": "Tosto vedrete il cielo"}, {"type": "l", "n": 57, "id": "c33.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "Imbiancar novamente, e sorger l’alba:", "html": "Imbiancar novamente, e sorger l’alba:"}, {"type": "l", "n": 58, "id": "c33.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "Alla qual poscia seguitando il sole,", "html": "Alla qual poscia seguitando il sole,"}, {"type": "l", "n": 59, "id": "c33.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "E folgorando intorno", "html": "E folgorando intorno"}, {"type": "l", "n": 60, "id": "c33.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "Con sue fiamme possenti,", "html": "Con sue fiamme possenti,"}, {"type": "l", "n": 61, "id": "c33.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Di lucidi torrenti", "html": "Di lucidi torrenti"}, {"type": "l", "n": 62, "id": "c33.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "Inonderà con voi gli eterei campi.", "html": "Inonderà con voi gli eterei campi."}, {"type": "l", "n": 63, "id": "c33.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma la vita mortal, poi che la bella", "html": "Ma la vita mortal, poi che la bella"}, {"type": "l", "n": 64, "id": "c33.v64", "indent": 0, "missing": false, "unnumbered": false, "text": "Giovinezza sparì, non si colora", "html": "Giovinezza sparì, non si colora"}, {"type": "l", "n": 65, "id": "c33.v65", "indent": 0, "missing": false, "unnumbered": false, "text": "D’altra luce giammai, nè d’altra aurora.", "html": "D’altra luce giammai, nè d’altra aurora."}, {"type": "l", "n": 66, "id": "c33.v66", "indent": 0, "missing": false, "unnumbered": false, "text": "Vedova è insino al fine; ed alla notte", "html": "Vedova è insino al fine; ed alla notte"}, {"type": "l", "n": 67, "id": "c33.v67", "indent": 0, "missing": false, "unnumbered": false, "text": "Che l’altre etadi oscura,", "html": "Che l’altre etadi oscura,"}, {"type": "l", "n": 68, "id": "c33.v68", "indent": 0, "missing": false, "unnumbered": false, "text": "Segno poser gli Dei la sepoltura.", "html": "Segno poser gli Dei la sepoltura."}]]}
