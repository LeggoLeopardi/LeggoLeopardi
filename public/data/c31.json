{"n": 31, "roman": "XXXI", "title": "Sopra il ritratto di una bella donna, scolpito nel monumento sepolcrale della medesima", "slug": "sopra-il-ritratto-di-una-bella-donna-scolpito-nel-monumento-sepolcrale-della-medesima", "incipit": "Tal fosti: or qui sotterra", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXI._Sopra_il_monumento_di_una_bella_donna%2C_scolpito_nel_monumento_sepolcrale_della_medesima_p._144", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXI._Sopra_il_monumento_di_una_bella_donna%2C_scolpito_nel_monumento_sepolcrale_della_medesima_p._145", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXXI._Sopra_il_monumento_di_una_bella_donna%2C_scolpito_nel_monumento_sepolcrale_della_medesima_p._146"]}, "head": ["XXXI.", "SOPRA IL RITRATTO", "DI UNA BELLA DONNA", "SCOLPITO NEL MONUMENTO SEPOLCRALE", "DELLA MEDESIMA."], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c31.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Tal fosti: or qui sotterra", "html": "Tal fosti: or qui sotterra"}, {"type": "l", "n": 2, "id": "c31.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Polve e scheletro sei. Su l'ossa e il fango", "html": "Polve e scheletro sei. Su l'ossa e il fango"}, {"type": "l", "n": 3, "id": "c31.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Immobilmente collocato invano,", "html": "Immobilmente collocato invano,"}, {"type": "l", "n": 4, "id": "c31.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Muto, mirando dell'etadi il volo,", "html": "Muto, mirando dell'etadi il volo,"}, {"type": "l", "n": 5, "id": "c31.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Sta, di memoria solo", "html": "Sta, di memoria solo"}, {"type": "l", "n": 6, "id": "c31.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "E di dolor custode, il simulacro", "html": "E di dolor custode, il simulacro"}, {"type": "l", "n": 7, "id": "c31.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Della scorsa beltà. Quel dolce sguardo,", "html": "Della scorsa beltà. Quel dolce sguardo,"}, {"type": "l", "n": 8, "id": "c31.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Che tremar fe, se, come or sembra, immoto", "html": "Che tremar fe, se, come or sembra, immoto"}, {"type": "l", "n": 9, "id": "c31.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "In altrui s'affisò; quel labbro, ondulato", "html": "In altrui s'affisò; quel labbro, ondulato"}, {"type": "l", "n": 10, "id": "c31.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "Par, come d'urna piena,", "html": "Par, come d'urna piena,"}, {"type": "l", "n": 11, "id": "c31.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Traboccare il piacer; quel collo, cinto", "html": "Traboccare il piacer; quel collo, cinto"}, {"type": "l", "n": 12, "id": "c31.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Già di desio; quell'amorosa mano,", "html": "Già di desio; quell'amorosa mano,"}, {"type": "l", "n": 13, "id": "c31.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Che spesso, ove fu porta,", "html": "Che spesso, ove fu porta,"}, {"type": "l", "n": 14, "id": "c31.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Sentì gelida far la man che strinse;", "html": "Sentì gelida far la man che strinse;"}, {"type": "l", "n": 15, "id": "c31.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "E il seno, onde la gente", "html": "E il seno, onde la gente"}, {"type": "l", "n": 16, "id": "c31.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Visibilmente di pallor si tinse,", "html": "Visibilmente di pallor si tinse,"}, {"type": "l", "n": 17, "id": "c31.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Furo alcun tempo: or fango", "html": "Furo alcun tempo: or fango"}, {"type": "l", "n": 18, "id": "c31.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed ossa sei: la vista", "html": "Ed ossa sei: la vista"}, {"type": "l", "n": 19, "id": "c31.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Vituperosa e trista un sasso asconde.", "html": "Vituperosa e trista un sasso asconde."}], [{"type": "l", "n": 20, "id": "c31.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Così riduce il fato", "html": "Così riduce il fato"}, {"type": "l", "n": 21, "id": "c31.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Qual sembianza fra noi parve più viva", "html": "Qual sembianza fra noi parve più viva"}, {"type": "l", "n": 22, "id": "c31.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Immagine del ciel. Misterio eterno", "html": "Immagine del ciel. Misterio eterno"}, {"type": "l", "n": 23, "id": "c31.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Dell’esser nostro. Oggi d’eccelsi, immensi", "html": "Dell’esser nostro. Oggi d’eccelsi, immensi"}, {"type": "l", "n": 24, "id": "c31.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Pensieri e sensi inenarrabil fonte,", "html": "Pensieri e sensi inenarrabil fonte,"}, {"type": "l", "n": 25, "id": "c31.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Beltà grandeggia, e pare,", "html": "Beltà grandeggia, e pare,"}, {"type": "l", "n": 26, "id": "c31.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Quale splendor vibrato", "html": "Quale splendor vibrato"}, {"type": "l", "n": 27, "id": "c31.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "Da natura immortal su queste arene,", "html": "Da natura immortal su queste arene,"}, {"type": "l", "n": 28, "id": "c31.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Di sovrumani fati,", "html": "Di sovrumani fati,"}, {"type": "l", "n": 29, "id": "c31.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Di fortunati regni e d’aurei mondi", "html": "Di fortunati regni e d’aurei mondi"}, {"type": "l", "n": 30, "id": "c31.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Segno e sicura spene", "html": "Segno e sicura spene"}, {"type": "l", "n": 31, "id": "c31.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Dare al mortale stato:", "html": "Dare al mortale stato:"}, {"type": "l", "n": 32, "id": "c31.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Diman, per lieve forza,", "html": "Diman, per lieve forza,"}, {"type": "l", "n": 33, "id": "c31.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Sozzo a vedere, abominoso, abbietto", "html": "Sozzo a vedere, abominoso, abbietto"}, {"type": "l", "n": 34, "id": "c31.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "Divien quel che fu dianzi", "html": "Divien quel che fu dianzi"}, {"type": "l", "n": 35, "id": "c31.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi angelico aspetto,", "html": "Quasi angelico aspetto,"}, {"type": "l", "n": 36, "id": "c31.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "E dalle menti insieme", "html": "E dalle menti insieme"}, {"type": "l", "n": 37, "id": "c31.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel che da lui moveva", "html": "Quel che da lui moveva"}, {"type": "l", "n": 38, "id": "c31.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "Ammirabil concetto, si dilegua.", "html": "Ammirabil concetto, si dilegua."}], [{"type": "l", "n": 39, "id": "c31.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Desiderii infiniti", "html": "Desiderii infiniti"}, {"type": "l", "n": 40, "id": "c31.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "E visioni altere", "html": "E visioni altere"}, {"type": "l", "n": 41, "id": "c31.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Crea nel vago pensiere,", "html": "Crea nel vago pensiere,"}, {"type": "l", "n": 42, "id": "c31.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Per natural virtù, dotto concento;", "html": "Per natural virtù, dotto concento;"}, {"type": "l", "n": 43, "id": "c31.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "Onde per mar delizioso, arcano", "html": "Onde per mar delizioso, arcano"}, {"type": "l", "n": 44, "id": "c31.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Erra lo spirto umano,", "html": "Erra lo spirto umano,"}, {"type": "l", "n": 45, "id": "c31.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi come a diporto", "html": "Quasi come a diporto"}, {"type": "l", "n": 46, "id": "c31.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "Ardito notator per l’Oceano:", "html": "Ardito notator per l’Oceano:"}, {"type": "l", "n": 47, "id": "c31.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma se un discorde accento", "html": "Ma se un discorde accento"}, {"type": "l", "n": 48, "id": "c31.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Fere l’orecchio, in nulla", "html": "Fere l’orecchio, in nulla"}, {"type": "l", "n": 49, "id": "c31.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "Torna quel paradiso in un momento.", "html": "Torna quel paradiso in un momento."}], [{"type": "l", "n": 50, "id": "c31.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Natura umana, or come,", "html": "Natura umana, or come,"}, {"type": "l", "n": 51, "id": "c31.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Se frale in tutto e vile,", "html": "Se frale in tutto e vile,"}, {"type": "l", "n": 52, "id": "c31.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Se polve ed ombra sei, tant’alto senti?", "html": "Se polve ed ombra sei, tant’alto senti?"}, {"type": "l", "n": 53, "id": "c31.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Se in parte anco gentile,", "html": "Se in parte anco gentile,"}, {"type": "l", "n": 54, "id": "c31.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Come i più degni tuoi moti e pensieri", "html": "Come i più degni tuoi moti e pensieri"}, {"type": "l", "n": 55, "id": "c31.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Son così di leggeri", "html": "Son così di leggeri"}, {"type": "l", "n": 56, "id": "c31.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Da sì basse cagioni e desti e spenti?", "html": "Da sì basse cagioni e desti e spenti?"}]]}
