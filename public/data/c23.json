{"n": 23, "roman": "XXIII", "title": "Canto notturno di un pastore errante dell'Asia", "slug": "canto-notturno-di-un-pastore-errante-dell-asia", "incipit": "Che fai tu, luna, in ciel? dimmi, che fai,", "status": {"leggo": "provisional", "traduco": "none", "collaziono": "none", "concordanza": "none"}, "source": {"label": "WikiLeopardi", "status": "provisional", "pages": ["https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._108", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._109", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._110", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._111", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._112", "https://wikileopardi.altervista.org/wiki_leopardi/index.php?title=N35c_XXIII._%C7%81_CANTO_NOTTURNO_%C7%81_DI_UN_PASTORE_ERRANTE_DELL%27ASIA_p._113"]}, "head": ["XXIII.", "CANTO NOTTURNO", "DI UN PASTORE ERRANTE DELL'ASIA (9)"], "epigraph": [], "stanzas": [[{"type": "l", "n": 1, "id": "c23.v1", "indent": 0, "missing": false, "unnumbered": false, "text": "Che fai tu, luna, in ciel? dimmi, che fai,", "html": "Che fai tu, luna, in ciel? dimmi, che fai,"}, {"type": "l", "n": 2, "id": "c23.v2", "indent": 0, "missing": false, "unnumbered": false, "text": "Silenziosa luna?", "html": "Silenziosa luna?"}, {"type": "l", "n": 3, "id": "c23.v3", "indent": 0, "missing": false, "unnumbered": false, "text": "Sorgi la sera, e vai,", "html": "Sorgi la sera, e vai,"}, {"type": "l", "n": 4, "id": "c23.v4", "indent": 0, "missing": false, "unnumbered": false, "text": "Contemplando i deserti; indi ti posi.", "html": "Contemplando i deserti; indi ti posi."}, {"type": "l", "n": 5, "id": "c23.v5", "indent": 0, "missing": false, "unnumbered": false, "text": "Ancor non sei tu paga", "html": "Ancor non sei tu paga"}, {"type": "l", "n": 6, "id": "c23.v6", "indent": 0, "missing": false, "unnumbered": false, "text": "Di riandare i sempiterni calli?", "html": "Di riandare i sempiterni calli?"}, {"type": "l", "n": 7, "id": "c23.v7", "indent": 0, "missing": false, "unnumbered": false, "text": "Ancor non prendi a schivo, ancor sei vaga", "html": "Ancor non prendi a schivo, ancor sei vaga"}, {"type": "l", "n": 8, "id": "c23.v8", "indent": 0, "missing": false, "unnumbered": false, "text": "Di mirar queste valli?", "html": "Di mirar queste valli?"}, {"type": "l", "n": 9, "id": "c23.v9", "indent": 0, "missing": false, "unnumbered": false, "text": "Somiglia alla tua vita", "html": "Somiglia alla tua vita"}, {"type": "l", "n": 10, "id": "c23.v10", "indent": 0, "missing": false, "unnumbered": false, "text": "La vita del pastore.", "html": "La vita del pastore."}, {"type": "l", "n": 11, "id": "c23.v11", "indent": 0, "missing": false, "unnumbered": false, "text": "Sorge in sul primo albore", "html": "Sorge in sul primo albore"}, {"type": "l", "n": 12, "id": "c23.v12", "indent": 0, "missing": false, "unnumbered": false, "text": "Move la greggia oltre pel campo, e vede", "html": "Move la greggia oltre pel campo, e vede"}, {"type": "l", "n": 13, "id": "c23.v13", "indent": 0, "missing": false, "unnumbered": false, "text": "Greggi, fontane ed erbe;", "html": "Greggi, fontane ed erbe;"}, {"type": "l", "n": 14, "id": "c23.v14", "indent": 0, "missing": false, "unnumbered": false, "text": "Poi stanco si riposa in su la sera:", "html": "Poi stanco si riposa in su la sera:"}, {"type": "l", "n": 15, "id": "c23.v15", "indent": 0, "missing": false, "unnumbered": false, "text": "Altro mai non ispera.", "html": "Altro mai non ispera."}, {"type": "l", "n": 16, "id": "c23.v16", "indent": 0, "missing": false, "unnumbered": false, "text": "Dimmi, o luna: a che vale", "html": "Dimmi, o luna: a che vale"}, {"type": "l", "n": 17, "id": "c23.v17", "indent": 0, "missing": false, "unnumbered": false, "text": "Al pastor la sua vita,", "html": "Al pastor la sua vita,"}, {"type": "l", "n": 18, "id": "c23.v18", "indent": 0, "missing": false, "unnumbered": false, "text": "La vostra vita a voi? dimmi: ove tende", "html": "La vostra vita a voi? dimmi: ove tende"}, {"type": "l", "n": 19, "id": "c23.v19", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo vagar mio breve,", "html": "Questo vagar mio breve,"}, {"type": "l", "n": 20, "id": "c23.v20", "indent": 0, "missing": false, "unnumbered": false, "text": "Il tuo corso immortale?", "html": "Il tuo corso immortale?"}], [{"type": "l", "n": 21, "id": "c23.v21", "indent": 0, "missing": false, "unnumbered": false, "text": "Vecchierel bianco, infermo,", "html": "Vecchierel bianco, infermo,"}, {"type": "l", "n": 22, "id": "c23.v22", "indent": 0, "missing": false, "unnumbered": false, "text": "Mezzo vestito e scalzo,", "html": "Mezzo vestito e scalzo,"}, {"type": "l", "n": 23, "id": "c23.v23", "indent": 0, "missing": false, "unnumbered": false, "text": "Con gravissimo fascio in su le spalle,", "html": "Con gravissimo fascio in su le spalle,"}, {"type": "l", "n": 24, "id": "c23.v24", "indent": 0, "missing": false, "unnumbered": false, "text": "Per montagna e per valle,", "html": "Per montagna e per valle,"}, {"type": "l", "n": 25, "id": "c23.v25", "indent": 0, "missing": false, "unnumbered": false, "text": "Per sassi acuti, ed alta rena, e fratte,", "html": "Per sassi acuti, ed alta rena, e fratte,"}, {"type": "l", "n": 26, "id": "c23.v26", "indent": 0, "missing": false, "unnumbered": false, "text": "Al vento, alla tempesta, e quando avvampa", "html": "Al vento, alla tempesta, e quando avvampa"}, {"type": "l", "n": 27, "id": "c23.v27", "indent": 0, "missing": false, "unnumbered": false, "text": "L’ora, e quando poi gela,", "html": "L’ora, e quando poi gela,"}, {"type": "l", "n": 28, "id": "c23.v28", "indent": 0, "missing": false, "unnumbered": false, "text": "Corre via, corre, anela,", "html": "Corre via, corre, anela,"}, {"type": "l", "n": 29, "id": "c23.v29", "indent": 0, "missing": false, "unnumbered": false, "text": "Varca torrenti e stagni,", "html": "Varca torrenti e stagni,"}, {"type": "l", "n": 30, "id": "c23.v30", "indent": 0, "missing": false, "unnumbered": false, "text": "Cade, risorge, e più e più s’affretta,", "html": "Cade, risorge, e più e più s’affretta,"}, {"type": "l", "n": 31, "id": "c23.v31", "indent": 0, "missing": false, "unnumbered": false, "text": "Senza posa o ristoro,", "html": "Senza posa o ristoro,"}, {"type": "l", "n": 32, "id": "c23.v32", "indent": 0, "missing": false, "unnumbered": false, "text": "Lacero, sanguinoso; infin ch’arriva", "html": "Lacero, sanguinoso; infin ch’arriva"}, {"type": "l", "n": 33, "id": "c23.v33", "indent": 0, "missing": false, "unnumbered": false, "text": "Colà dove la via", "html": "Colà dove la via"}, {"type": "l", "n": 34, "id": "c23.v34", "indent": 0, "missing": false, "unnumbered": false, "text": "E dove il tanto affaticar fu volto:", "html": "E dove il tanto affaticar fu volto:"}, {"type": "l", "n": 35, "id": "c23.v35", "indent": 0, "missing": false, "unnumbered": false, "text": "Abisso orrido, immenso,", "html": "Abisso orrido, immenso,"}, {"type": "l", "n": 36, "id": "c23.v36", "indent": 0, "missing": false, "unnumbered": false, "text": "Ov’ei precipitando, il tutto obblia.", "html": "Ov’ei precipitando, il tutto obblia."}, {"type": "l", "n": 37, "id": "c23.v37", "indent": 0, "missing": false, "unnumbered": false, "text": "Vergine luna, tale", "html": "Vergine luna, tale"}, {"type": "l", "n": 38, "id": "c23.v38", "indent": 0, "missing": false, "unnumbered": false, "text": "È la vita mortale.", "html": "È la vita mortale."}], [{"type": "l", "n": 39, "id": "c23.v39", "indent": 0, "missing": false, "unnumbered": false, "text": "Nasce l’uomo a fatica,", "html": "Nasce l’uomo a fatica,"}, {"type": "l", "n": 40, "id": "c23.v40", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed è rischio di morte il nascimento.", "html": "Ed è rischio di morte il nascimento."}, {"type": "l", "n": 41, "id": "c23.v41", "indent": 0, "missing": false, "unnumbered": false, "text": "Prova pena e tormento", "html": "Prova pena e tormento"}, {"type": "l", "n": 42, "id": "c23.v42", "indent": 0, "missing": false, "unnumbered": false, "text": "Per prima cosa; e in sul principio stesso", "html": "Per prima cosa; e in sul principio stesso"}, {"type": "l", "n": 43, "id": "c23.v43", "indent": 0, "missing": false, "unnumbered": false, "text": "La madre e il genitore", "html": "La madre e il genitore"}, {"type": "l", "n": 44, "id": "c23.v44", "indent": 0, "missing": false, "unnumbered": false, "text": "Il prende a consolar dell’esser nato.", "html": "Il prende a consolar dell’esser nato."}, {"type": "l", "n": 45, "id": "c23.v45", "indent": 0, "missing": false, "unnumbered": false, "text": "Poi che crescendo viene,", "html": "Poi che crescendo viene,"}, {"type": "l", "n": 46, "id": "c23.v46", "indent": 0, "missing": false, "unnumbered": false, "text": "L’uno e l’altro il sostiene, e via pur sempre", "html": "L’uno e l’altro il sostiene, e via pur sempre"}, {"type": "l", "n": 47, "id": "c23.v47", "indent": 0, "missing": false, "unnumbered": false, "text": "Con atti e con parole", "html": "Con atti e con parole"}, {"type": "l", "n": 48, "id": "c23.v48", "indent": 0, "missing": false, "unnumbered": false, "text": "Studiasi fargli core,", "html": "Studiasi fargli core,"}, {"type": "l", "n": 49, "id": "c23.v49", "indent": 0, "missing": false, "unnumbered": false, "text": "E consolarlo dell'umano stato:", "html": "E consolarlo dell'umano stato:"}, {"type": "l", "n": 50, "id": "c23.v50", "indent": 0, "missing": false, "unnumbered": false, "text": "Altro ufficio più grato", "html": "Altro ufficio più grato"}, {"type": "l", "n": 51, "id": "c23.v51", "indent": 0, "missing": false, "unnumbered": false, "text": "Non si fa da parenti alla lor prole.", "html": "Non si fa da parenti alla lor prole."}, {"type": "l", "n": 52, "id": "c23.v52", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma perchè dare al sole,", "html": "Ma perchè dare al sole,"}, {"type": "l", "n": 53, "id": "c23.v53", "indent": 0, "missing": false, "unnumbered": false, "text": "Perchè reggere in vita", "html": "Perchè reggere in vita"}, {"type": "l", "n": 54, "id": "c23.v54", "indent": 0, "missing": false, "unnumbered": false, "text": "Chi poi di quella consolar convenga?", "html": "Chi poi di quella consolar convenga?"}, {"type": "l", "n": 55, "id": "c23.v55", "indent": 0, "missing": false, "unnumbered": false, "text": "Se la vita è sventura,", "html": "Se la vita è sventura,"}, {"type": "l", "n": 56, "id": "c23.v56", "indent": 0, "missing": false, "unnumbered": false, "text": "Perchè da noi si dura?", "html": "Perchè da noi si dura?"}, {"type": "l", "n": 57, "id": "c23.v57", "indent": 0, "missing": false, "unnumbered": false, "text": "Intatta luna, tale", "html": "Intatta luna, tale"}, {"type": "l", "n": 58, "id": "c23.v58", "indent": 0, "missing": false, "unnumbered": false, "text": "È lo stato mortale.", "html": "È lo stato mortale."}, {"type": "l", "n": 59, "id": "c23.v59", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma tu mortal non sei,", "html": "Ma tu mortal non sei,"}, {"type": "l", "n": 60, "id": "c23.v60", "indent": 0, "missing": false, "unnumbered": false, "text": "E forse del mio dir poco ti cale.", "html": "E forse del mio dir poco ti cale."}], [{"type": "l", "n": 61, "id": "c23.v61", "indent": 0, "missing": false, "unnumbered": false, "text": "Pur tu, solinga, eterna peregrina,", "html": "Pur tu, solinga, eterna peregrina,"}, {"type": "l", "n": 62, "id": "c23.v62", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sì pensosa sei, tu forse intendi,", "html": "Che sì pensosa sei, tu forse intendi,"}, {"type": "l", "n": 63, "id": "c23.v63", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo viver terreno,", "html": "Questo viver terreno,"}, {"type": "l", "n": 64, "id": "c23.v64", "indent": 0, "missing": false, "unnumbered": false, "text": "Il patir nostro, il sospirar, che sia;", "html": "Il patir nostro, il sospirar, che sia;"}, {"type": "l", "n": 65, "id": "c23.v65", "indent": 0, "missing": false, "unnumbered": false, "text": "Che sia questo morir, questo supremo", "html": "Che sia questo morir, questo supremo"}, {"type": "l", "n": 66, "id": "c23.v66", "indent": 0, "missing": false, "unnumbered": false, "text": "Scolorar del sembiante,", "html": "Scolorar del sembiante,"}, {"type": "l", "n": 67, "id": "c23.v67", "indent": 0, "missing": false, "unnumbered": false, "text": "E perir dalla terra, e venir meno", "html": "E perir dalla terra, e venir meno"}, {"type": "l", "n": 68, "id": "c23.v68", "indent": 0, "missing": false, "unnumbered": false, "text": "Ad ogni usata, amante compagnia.", "html": "Ad ogni usata, amante compagnia."}, {"type": "l", "n": 69, "id": "c23.v69", "indent": 0, "missing": false, "unnumbered": false, "text": "E tu certo comprendi", "html": "E tu certo comprendi"}, {"type": "l", "n": 70, "id": "c23.v70", "indent": 0, "missing": false, "unnumbered": false, "text": "Il perchè delle cose, e vedi il frutto", "html": "Il perchè delle cose, e vedi il frutto"}, {"type": "l", "n": 71, "id": "c23.v71", "indent": 0, "missing": false, "unnumbered": false, "text": "Del mattin, della sera,", "html": "Del mattin, della sera,"}, {"type": "l", "n": 72, "id": "c23.v72", "indent": 0, "missing": false, "unnumbered": false, "text": "Del tacito, infinito andar del tempo.", "html": "Del tacito, infinito andar del tempo."}, {"type": "l", "n": 73, "id": "c23.v73", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu sai, tu certo, a qual suo dolce amore", "html": "Tu sai, tu certo, a qual suo dolce amore"}, {"type": "l", "n": 74, "id": "c23.v74", "indent": 0, "missing": false, "unnumbered": false, "text": "Rida la primavera,", "html": "Rida la primavera,"}, {"type": "l", "n": 75, "id": "c23.v75", "indent": 0, "missing": false, "unnumbered": false, "text": "A chi giovi l’ardore, e che procacci", "html": "A chi giovi l’ardore, e che procacci"}, {"type": "l", "n": 76, "id": "c23.v76", "indent": 0, "missing": false, "unnumbered": false, "text": "Il verno co’ suoi ghiacci.", "html": "Il verno co’ suoi ghiacci."}, {"type": "l", "n": 77, "id": "c23.v77", "indent": 0, "missing": false, "unnumbered": false, "text": "Mille cose sai tu, mille discopri,", "html": "Mille cose sai tu, mille discopri,"}, {"type": "l", "n": 78, "id": "c23.v78", "indent": 0, "missing": false, "unnumbered": false, "text": "Che son celate al semplice pastore.", "html": "Che son celate al semplice pastore."}, {"type": "l", "n": 79, "id": "c23.v79", "indent": 0, "missing": false, "unnumbered": false, "text": "Spesso quand’io ti miro", "html": "Spesso quand’io ti miro"}, {"type": "l", "n": 80, "id": "c23.v80", "indent": 0, "missing": false, "unnumbered": false, "text": "Star così muta in sul deserto piano,", "html": "Star così muta in sul deserto piano,"}, {"type": "l", "n": 81, "id": "c23.v81", "indent": 0, "missing": false, "unnumbered": false, "text": "Che, in suo giro lontano, al ciel confina;", "html": "Che, in suo giro lontano, al ciel confina;"}, {"type": "l", "n": 82, "id": "c23.v82", "indent": 0, "missing": false, "unnumbered": false, "text": "Ovver con la mia greggia", "html": "Ovver con la mia greggia"}, {"type": "l", "n": 83, "id": "c23.v83", "indent": 0, "missing": false, "unnumbered": false, "text": "Seguirmi viaggiando a mano a mano;", "html": "Seguirmi viaggiando a mano a mano;"}, {"type": "l", "n": 84, "id": "c23.v84", "indent": 0, "missing": false, "unnumbered": false, "text": "E quando miro in cielo arder le stelle;", "html": "E quando miro in cielo arder le stelle;"}, {"type": "l", "n": 85, "id": "c23.v85", "indent": 0, "missing": false, "unnumbered": false, "text": "Dico fra me pensando:", "html": "Dico fra me pensando:"}, {"type": "l", "n": 86, "id": "c23.v86", "indent": 0, "missing": false, "unnumbered": false, "text": "A che tante facelle?", "html": "A che tante facelle?"}, {"type": "l", "n": 87, "id": "c23.v87", "indent": 0, "missing": false, "unnumbered": false, "text": "Che fa l’aria infinita, e quel profondo", "html": "Che fa l’aria infinita, e quel profondo"}, {"type": "l", "n": 88, "id": "c23.v88", "indent": 0, "missing": false, "unnumbered": false, "text": "Infinito seren? che vuol dir questa", "html": "Infinito seren? che vuol dir questa"}, {"type": "l", "n": 89, "id": "c23.v89", "indent": 0, "missing": false, "unnumbered": false, "text": "Solitudine immensa? ed io che sono?", "html": "Solitudine immensa? ed io che sono?"}, {"type": "l", "n": 90, "id": "c23.v90", "indent": 0, "missing": false, "unnumbered": false, "text": "Così meco ragiono: e della stanza", "html": "Così meco ragiono: e della stanza"}, {"type": "l", "n": 91, "id": "c23.v91", "indent": 0, "missing": false, "unnumbered": false, "text": "Smisurata e superba,", "html": "Smisurata e superba,"}, {"type": "l", "n": 92, "id": "c23.v92", "indent": 0, "missing": false, "unnumbered": false, "text": "E dell'innumerabile famiglia;", "html": "E dell'innumerabile famiglia;"}, {"type": "l", "n": 93, "id": "c23.v93", "indent": 0, "missing": false, "unnumbered": false, "text": "Poi di tanto adoprar, di tanti moti", "html": "Poi di tanto adoprar, di tanti moti"}, {"type": "l", "n": 94, "id": "c23.v94", "indent": 0, "missing": false, "unnumbered": false, "text": "D’ogni celeste, ogni terrena cosa,", "html": "D’ogni celeste, ogni terrena cosa,"}, {"type": "l", "n": 95, "id": "c23.v95", "indent": 0, "missing": false, "unnumbered": false, "text": "Girando senza posa,", "html": "Girando senza posa,"}, {"type": "l", "n": 96, "id": "c23.v96", "indent": 0, "missing": false, "unnumbered": false, "text": "Per tornar sempre là donde son mosse;", "html": "Per tornar sempre là donde son mosse;"}, {"type": "l", "n": 97, "id": "c23.v97", "indent": 0, "missing": false, "unnumbered": false, "text": "Uso alcuno, alcun frutto", "html": "Uso alcuno, alcun frutto"}, {"type": "l", "n": 98, "id": "c23.v98", "indent": 0, "missing": false, "unnumbered": false, "text": "Indovinar non so. Ma tu per certo,", "html": "Indovinar non so. Ma tu per certo,"}, {"type": "l", "n": 99, "id": "c23.v99", "indent": 0, "missing": false, "unnumbered": false, "text": "Giovinetta immortal, conosci il tutto.", "html": "Giovinetta immortal, conosci il tutto."}, {"type": "l", "n": 100, "id": "c23.v100", "indent": 0, "missing": false, "unnumbered": false, "text": "Questo io conosco e sento,", "html": "Questo io conosco e sento,"}, {"type": "l", "n": 101, "id": "c23.v101", "indent": 0, "missing": false, "unnumbered": false, "text": "Che degli eterni giri,", "html": "Che degli eterni giri,"}, {"type": "l", "n": 102, "id": "c23.v102", "indent": 0, "missing": false, "unnumbered": false, "text": "Che dell'esser mio frale,", "html": "Che dell'esser mio frale,"}, {"type": "l", "n": 103, "id": "c23.v103", "indent": 0, "missing": false, "unnumbered": false, "text": "Qualche bene o contento", "html": "Qualche bene o contento"}, {"type": "l", "n": 104, "id": "c23.v104", "indent": 0, "missing": false, "unnumbered": false, "text": "Avrà fors’altri; a me la vita è male.", "html": "Avrà fors’altri; a me la vita è male."}], [{"type": "l", "n": 105, "id": "c23.v105", "indent": 0, "missing": false, "unnumbered": false, "text": "O greggia mia che posi, oh te beata,", "html": "O greggia mia che posi, oh te beata,"}, {"type": "l", "n": 106, "id": "c23.v106", "indent": 0, "missing": false, "unnumbered": false, "text": "Che la miseria tua, credo, non sai!", "html": "Che la miseria tua, credo, non sai!"}, {"type": "l", "n": 107, "id": "c23.v107", "indent": 0, "missing": false, "unnumbered": false, "text": "Quanta invidia ti porto!", "html": "Quanta invidia ti porto!"}, {"type": "l", "n": 108, "id": "c23.v108", "indent": 0, "missing": false, "unnumbered": false, "text": "Non sol perchè d’affanno", "html": "Non sol perchè d’affanno"}, {"type": "l", "n": 109, "id": "c23.v109", "indent": 0, "missing": false, "unnumbered": false, "text": "Quasi libera vai;", "html": "Quasi libera vai;"}, {"type": "l", "n": 110, "id": "c23.v110", "indent": 0, "missing": false, "unnumbered": false, "text": "Ch’ogni stento, ogni danno,", "html": "Ch’ogni stento, ogni danno,"}, {"type": "l", "n": 111, "id": "c23.v111", "indent": 0, "missing": false, "unnumbered": false, "text": "Ogni estremo timor subito scordi;", "html": "Ogni estremo timor subito scordi;"}, {"type": "l", "n": 112, "id": "c23.v112", "indent": 0, "missing": false, "unnumbered": false, "text": "Ma più perchè giammai tedio non provi.", "html": "Ma più perchè giammai tedio non provi."}, {"type": "l", "n": 113, "id": "c23.v113", "indent": 0, "missing": false, "unnumbered": false, "text": "Quando tu siedi all'ombra, sovra l’erbe,", "html": "Quando tu siedi all'ombra, sovra l’erbe,"}, {"type": "l", "n": 114, "id": "c23.v114", "indent": 0, "missing": false, "unnumbered": false, "text": "Tu se’ queta e contenta;", "html": "Tu se’ queta e contenta;"}, {"type": "l", "n": 115, "id": "c23.v115", "indent": 0, "missing": false, "unnumbered": false, "text": "E gran parte dell'anno", "html": "E gran parte dell'anno"}, {"type": "l", "n": 116, "id": "c23.v116", "indent": 0, "missing": false, "unnumbered": false, "text": "Senza noia consumi in quello stato.", "html": "Senza noia consumi in quello stato."}, {"type": "l", "n": 117, "id": "c23.v117", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed io pur seggo sovra l’erbe, all'ombra,", "html": "Ed io pur seggo sovra l’erbe, all'ombra,"}, {"type": "l", "n": 118, "id": "c23.v118", "indent": 0, "missing": false, "unnumbered": false, "text": "E un fastidio m’ingombra", "html": "E un fastidio m’ingombra"}, {"type": "l", "n": 119, "id": "c23.v119", "indent": 0, "missing": false, "unnumbered": false, "text": "La mente, ed uno spron quasi mi punge", "html": "La mente, ed uno spron quasi mi punge"}, {"type": "l", "n": 120, "id": "c23.v120", "indent": 0, "missing": false, "unnumbered": false, "text": "Sì che, sedendo, più che mai son lunge", "html": "Sì che, sedendo, più che mai son lunge"}, {"type": "l", "n": 121, "id": "c23.v121", "indent": 0, "missing": false, "unnumbered": false, "text": "Da trovar pace o loco.", "html": "Da trovar pace o loco."}, {"type": "l", "n": 122, "id": "c23.v122", "indent": 0, "missing": false, "unnumbered": false, "text": "E pur nulla non bramo,", "html": "E pur nulla non bramo,"}, {"type": "l", "n": 123, "id": "c23.v123", "indent": 0, "missing": false, "unnumbered": false, "text": "E non ho fino a qui cagion di pianto.", "html": "E non ho fino a qui cagion di pianto."}, {"type": "l", "n": 124, "id": "c23.v124", "indent": 0, "missing": false, "unnumbered": false, "text": "Quel che tu goda o quanto,", "html": "Quel che tu goda o quanto,"}, {"type": "l", "n": 125, "id": "c23.v125", "indent": 0, "missing": false, "unnumbered": false, "text": "Non so già dir; ma fortunata sei.", "html": "Non so già dir; ma fortunata sei."}, {"type": "l", "n": 126, "id": "c23.v126", "indent": 0, "missing": false, "unnumbered": false, "text": "Ed io godo ancor poco,", "html": "Ed io godo ancor poco,"}, {"type": "l", "n": 127, "id": "c23.v127", "indent": 0, "missing": false, "unnumbered": false, "text": "O greggia mia, nè di ciò sol mi lagno.", "html": "O greggia mia, nè di ciò sol mi lagno."}, {"type": "l", "n": 128, "id": "c23.v128", "indent": 0, "missing": false, "unnumbered": false, "text": "Se tu parlar sapessi, io chiederei:", "html": "Se tu parlar sapessi, io chiederei:"}, {"type": "l", "n": 129, "id": "c23.v129", "indent": 0, "missing": false, "unnumbered": false, "text": "Dimmi: perchè giacendo", "html": "Dimmi: perchè giacendo"}, {"type": "l", "n": 130, "id": "c23.v130", "indent": 0, "missing": false, "unnumbered": false, "text": "A bell’agio, ozioso,", "html": "A bell’agio, ozioso,"}, {"type": "l", "n": 131, "id": "c23.v131", "indent": 0, "missing": false, "unnumbered": false, "text": "S’appaga ogni animale;", "html": "S’appaga ogni animale;"}, {"type": "l", "n": 132, "id": "c23.v132", "indent": 0, "missing": false, "unnumbered": false, "text": "Me, s’io giaccio in riposo, il tedio assale (10)?", "html": "Me, s’io giaccio in riposo, il tedio assale (<sup class=\"noteref\">10</sup>)?"}], [{"type": "l", "n": 133, "id": "c23.v133", "indent": 0, "missing": false, "unnumbered": false, "text": "Forse s'avess'io l’ale", "html": "Forse s'avess'io l’ale"}, {"type": "l", "n": 134, "id": "c23.v134", "indent": 0, "missing": false, "unnumbered": false, "text": "Da volar su le nubi,", "html": "Da volar su le nubi,"}, {"type": "l", "n": 135, "id": "c23.v135", "indent": 0, "missing": false, "unnumbered": false, "text": "E noverar le stelle ad una ad una,", "html": "E noverar le stelle ad una ad una,"}, {"type": "l", "n": 136, "id": "c23.v136", "indent": 0, "missing": false, "unnumbered": false, "text": "O come il tuono errar di giogo in giogo,", "html": "O come il tuono errar di giogo in giogo,"}, {"type": "l", "n": 137, "id": "c23.v137", "indent": 0, "missing": false, "unnumbered": false, "text": "Più felice sarei, dolce mia greggia,", "html": "Più felice sarei, dolce mia greggia,"}, {"type": "l", "n": 138, "id": "c23.v138", "indent": 0, "missing": false, "unnumbered": false, "text": "Più felice sarei, candida luna.", "html": "Più felice sarei, candida luna."}, {"type": "l", "n": 139, "id": "c23.v139", "indent": 0, "missing": false, "unnumbered": false, "text": "O forse erra dal vero,", "html": "O forse erra dal vero,"}, {"type": "l", "n": 140, "id": "c23.v140", "indent": 0, "missing": false, "unnumbered": false, "text": "Mirando all'altrui sorte, il mio pensiero:", "html": "Mirando all'altrui sorte, il mio pensiero:"}, {"type": "l", "n": 141, "id": "c23.v141", "indent": 0, "missing": false, "unnumbered": false, "text": "Forse in qual forma, in quale", "html": "Forse in qual forma, in quale"}, {"type": "l", "n": 142, "id": "c23.v142", "indent": 0, "missing": false, "unnumbered": false, "text": "Stato che sia, dentro covile o cuna,", "html": "Stato che sia, dentro covile o cuna,"}, {"type": "l", "n": 143, "id": "c23.v143", "indent": 0, "missing": false, "unnumbered": false, "text": "È funesto a chi nasce il dì natale.", "html": "È funesto a chi nasce il dì natale."}]]}
